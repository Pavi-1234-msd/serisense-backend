{"cells":[{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":14159,"status":"ok","timestamp":1785383484765,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"GMcEBuuzlnyT","outputId":"6b50bc66-2838-4d5a-b643-cf48d7f969f8"},"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Kaggle credentials set up!\n"]}],"source":["import os\n","os.makedirs('/root/.kaggle', exist_ok=True)\n","with open('/root/.kaggle/kaggle.json', 'w') as f:\n","    f.write('{\"username\":\"nithishkumar9360\",\"key\":\"KGAT_a6816d47b90f10cf29b6dd1912f1ec93\"}')\n","os.chmod('/root/.kaggle/kaggle.json', 600)\n","!pip install -q kaggle\n","print(\"✅ Kaggle credentials set up!\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":801164,"status":"ok","timestamp":1784714724401,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"a7fd5cde","outputId":"8d5aeff8-7d9b-4721-80a7-8aa2061ea621"},"outputs":[{"name":"stdout","output_type":"stream","text":["Warning: Looks like you're using an outdated `kaggle` version (installed: 2.0.2), please consider upgrading to the latest version (2.2.2)\n","Dataset URL: https://www.kaggle.com/datasets/nahiduzzaman13/mulberry-leaf-dataset\n","License(s): CC0-1.0\n","Downloading mulberry-leaf-dataset.zip to /content\n","100% 10.7G/10.7G [11:07<00:00, 17.1MB/s]\n","\n","Classes: ['Leaf Rust', 'Leaf spot', 'Disease Free leaves']\n"]}],"source":["# Re-download dataset\n","import os\n","\n","!kaggle datasets download -d nahiduzzaman13/mulberry-leaf-dataset\n","!unzip -q mulberry-leaf-dataset.zip -d mulberry_data\n","\n","# Verify\n","print(\"Classes:\", os.listdir('mulberry_data/Mulberry Data'))"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":17,"status":"ok","timestamp":1784714724415,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"L2Xb-leemiyy","outputId":"8c459da1-d7ae-4241-e6d0-f4ba741a2550"},"outputs":[{"name":"stdout","output_type":"stream","text":["Dataset already extracted.\n","Classes: ['Leaf Rust', 'Leaf spot', 'Disease Free leaves']\n"]}],"source":["import os\n","import zipfile\n","\n","DATA_DIR = 'mulberry_data'\n","ZIP_FILE = 'mulberry-leaf-dataset.zip'\n","EXTRACT_PATH = '.'\n","\n","# Check if the directory already exists\n","if not os.path.exists(os.path.join(DATA_DIR, 'Mulberry Data')):\n","    print(f\"Unzipping {ZIP_FILE}...\")\n","    if os.path.exists(ZIP_FILE):\n","        with zipfile.ZipFile(ZIP_FILE, 'r') as zip_ref:\n","            zip_ref.extractall(EXTRACT_PATH)\n","        print(\"✅ Dataset unzipped successfully!\")\n","    else:\n","        print(f\"Error: {ZIP_FILE} not found. Please ensure the dataset is uploaded or downloaded.\")\n","else:\n","    print(\"Dataset already extracted.\")\n","\n","# Verify the classes now\n","if os.path.exists(os.path.join(DATA_DIR, 'Mulberry Data')):\n","    print(\"Classes:\", os.listdir(os.path.join(DATA_DIR, 'Mulberry Data')))\n","else:\n","    print(\"Error: 'mulberry_data/Mulberry Data' still not found after attempting extraction.\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":8,"status":"ok","timestamp":1784714724425,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"Z5psbKJ2n1lN","outputId":"87b46972-8bd3-435a-a7c3-20c4450d88ab"},"outputs":[{"name":"stdout","output_type":"stream","text":["📁 mulberry_data/\n","   📂 Mulberry Data/\n","      🌿 Leaf Rust/ → 489 images\n","      🌿 Leaf spot/ → 162 images\n","      🌿 Disease Free leaves/ → 440 images\n"]}],"source":["# CELL 3 — Check folder structure and image counts\n","import os\n","\n","for root, dirs, files_list in os.walk('mulberry_data'):\n","    level = root.replace('mulberry_data', '').count(os.sep)\n","    if level > 2:\n","        continue\n","    indent = ' ' * 3 * level\n","    folder_name = os.path.basename(root)\n","    if level == 0:\n","        print(f\"📁 mulberry_data/\")\n","    elif level == 1:\n","        print(f\"   📂 {folder_name}/\")\n","    elif level == 2:\n","        img_count = len([f for f in files_list if f.lower().endswith(('.jpg','.jpeg','.png'))])\n","        print(f\"      🌿 {folder_name}/ → {img_count} images\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":667},"executionInfo":{"elapsed":33007,"status":"ok","timestamp":1784714757434,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"wVwanARtoBPe","outputId":"fd22aa3b-0c4d-4353-da4a-aa44d9b3c7ed"},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1400x1000 with 12 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["✅ Sample images shown!\n"]}],"source":["# CELL 4 — Visualise sample images from each class\n","import matplotlib.pyplot as plt\n","import matplotlib.image as mpimg\n","import os, random\n","\n","DATA_PATH = 'mulberry_data/Mulberry Data'\n","CLASSES = ['Disease Free leaves', 'Leaf Rust', 'Leaf spot']\n","\n","fig, axes = plt.subplots(3, 4, figsize=(14, 10))\n","fig.suptitle('Mulberry Leaf Dataset — Sample Images per Class', fontsize=14, fontweight='bold')\n","\n","for row, cls in enumerate(CLASSES):\n","    folder = os.path.join(DATA_PATH, cls)\n","    images = [f for f in os.listdir(folder) if f.lower().endswith(('.jpg','.jpeg','.png'))]\n","    samples = random.sample(images, 4)\n","    for col, img_name in enumerate(samples):\n","        img = mpimg.imread(os.path.join(folder, img_name))\n","        axes[row][col].imshow(img)\n","        axes[row][col].set_title(cls, fontsize=9, color='green' if cls=='Disease Free leaves' else 'red')\n","        axes[row][col].axis('off')\n","\n","plt.tight_layout()\n","plt.show()\n","print(\"✅ Sample images shown!\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":34468,"status":"ok","timestamp":1785383526248,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"Cso8gsAooUjj","outputId":"d877b8b0-53e1-4b07-b368-415923822eec"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:absl:Compiled the loaded model, but the compiled metrics have yet to be built. `model.compile_metrics` will be empty until you train or evaluate the model.\n"]},{"output_type":"stream","name":"stdout","text":["✅ Model loaded from Google Drive!\n","   Classes: ['Disease Free leaves', 'Leaf Rust', 'Leaf spot']\n"]}],"source":["# CELL 5 (NEW) — Load saved model instead of retraining\n","from google.colab import drive\n","import tensorflow as tf\n","import json\n","\n","drive.mount('/content/drive')\n","\n","model = tf.keras.models.load_model(\n","    '/content/drive/MyDrive/mulberry_disease_model_finetuned.h5'\n",")\n","\n","with open('/content/drive/MyDrive/class_names.json', 'r') as f:\n","    CLASS_NAMES = json.load(f)\n","\n","DATA_PATH = 'mulberry_data/Mulberry Data'\n","\n","print(\"✅ Model loaded from Google Drive!\")\n","print(f\"   Classes: {CLASS_NAMES}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":548},"executionInfo":{"elapsed":173,"status":"error","timestamp":1784714904219,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"xPE-vAucJ5J1","outputId":"be5a445f-7704-437c-9795-523ea20b4b6a"},"outputs":[{"ename":"NameError","evalue":"name 'history' is not defined","output_type":"error","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mNameError\u001b[0m                                 Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_622/513783675.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m      4\u001b[0m \u001b[0mfig\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m(\u001b[0m\u001b[0max1\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0max2\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mplt\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0msubplots\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;36m1\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;36m2\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mfigsize\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;36m14\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;36m5\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m      5\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m----> 6\u001b[0;31m \u001b[0max1\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mplot\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mhistory\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mhistory\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0;34m'accuracy'\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mlabel\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m'Train Accuracy'\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mcolor\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m'green'\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mlinewidth\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;36m2\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m      7\u001b[0m \u001b[0max1\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mplot\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mhistory\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mhistory\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0;34m'val_accuracy'\u001b[0m\u001b[0;34m]\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mlabel\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m'Val Accuracy'\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mcolor\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m'orange'\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mlinewidth\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;36m2\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m      8\u001b[0m \u001b[0max1\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mset_title\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m'Model Accuracy'\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mfontsize\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;36m14\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mfontweight\u001b[0m\u001b[0;34m=\u001b[0m\u001b[0;34m'bold'\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mNameError\u001b[0m: name 'history' is not defined"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1400x500 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# CELL 6 — Plot training graphs\n","import matplotlib.pyplot as plt\n","\n","fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n","\n","ax1.plot(history.history['accuracy'], label='Train Accuracy', color='green', linewidth=2)\n","ax1.plot(history.history['val_accuracy'], label='Val Accuracy', color='orange', linewidth=2)\n","ax1.set_title('Model Accuracy', fontsize=14, fontweight='bold')\n","ax1.set_xlabel('Epoch')\n","ax1.set_ylabel('Accuracy')\n","ax1.legend()\n","ax1.grid(True, alpha=0.3)\n","ax1.set_ylim([0.5, 1.0])\n","\n","ax2.plot(history.history['loss'], label='Train Loss', color='green', linewidth=2)\n","ax2.plot(history.history['val_loss'], label='Val Loss', color='orange', linewidth=2)\n","ax2.set_title('Model Loss', fontsize=14, fontweight='bold')\n","ax2.set_xlabel('Epoch')\n","ax2.set_ylabel('Loss')\n","ax2.legend()\n","ax2.grid(True, alpha=0.3)\n","\n","plt.suptitle('MobileNetV2 — Mulberry Leaf Disease Detection', fontsize=13)\n","plt.tight_layout()\n","plt.show()\n","print(\"✅ Graphs plotted!\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"-e6eSs1FJ8N9"},"outputs":[],"source":["# CELL 7 — Confusion matrix + classification report\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from sklearn.metrics import classification_report, confusion_matrix\n","\n","CLASS_NAMES = list(train_gen.class_indices.keys())\n","\n","val_gen.reset()\n","y_pred_probs = model.predict(val_gen, verbose=1)\n","y_pred = np.argmax(y_pred_probs, axis=1)\n","y_true = val_gen.classes\n","\n","cm = confusion_matrix(y_true, y_pred)\n","plt.figure(figsize=(8, 6))\n","sns.heatmap(cm, annot=True, fmt='d', cmap='Greens',\n","            xticklabels=CLASS_NAMES, yticklabels=CLASS_NAMES)\n","plt.title('Confusion Matrix', fontsize=14, fontweight='bold')\n","plt.ylabel('Actual Label')\n","plt.xlabel('Predicted Label')\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"\\n📊 Classification Report:\")\n","print(\"=\"*55)\n","print(classification_report(y_true, y_pred, target_names=CLASS_NAMES))"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"ACNmK5H9KZ78","colab":{"base_uri":"https://localhost:8080/","height":245},"executionInfo":{"status":"error","timestamp":1785137292534,"user_tz":-330,"elapsed":45,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"}},"outputId":"9236c3fd-78ba-4210-f4ef-a474a4eadeca"},"outputs":[{"output_type":"stream","name":"stdout","text":["Testing on sample images from each class...\n","\n"]},{"output_type":"error","ename":"FileNotFoundError","evalue":"[Errno 2] No such file or directory: 'mulberry_data/Mulberry Data/Disease Free leaves'","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mFileNotFoundError\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_2558/2495875990.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     94\u001b[0m \u001b[0;32mfor\u001b[0m \u001b[0mcls\u001b[0m \u001b[0;32min\u001b[0m \u001b[0mCLASS_NAMES\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     95\u001b[0m     \u001b[0mfolder\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mos\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mpath\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mjoin\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mDATA_PATH\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mcls\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 96\u001b[0;31m     sample = random.choice([f for f in os.listdir(folder)\n\u001b[0m\u001b[1;32m     97\u001b[0m                             if f.lower().endswith(('.jpg','.jpeg','.png'))])\n\u001b[1;32m     98\u001b[0m     \u001b[0mpredicted_class\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mconf\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mpredict_and_advise\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mos\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mpath\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mjoin\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mfolder\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0msample\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mFileNotFoundError\u001b[0m: [Errno 2] No such file or directory: 'mulberry_data/Mulberry Data/Disease Free leaves'"]}],"source":["# CELL 8 — Treatment advice system\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.image as mpimg\n","from tensorflow.keras.preprocessing import image\n","import random, os\n","\n","TREATMENT_ADVICE = {\n","    'Disease Free leaves': {\n","        'status'  : '✅ HEALTHY',\n","        'color'   : 'green',\n","        'summary' : 'Your mulberry leaves are healthy and suitable for silkworm feeding.',\n","        'actions' : [\n","            'Continue regular irrigation and fertilisation.',\n","            'Monitor leaves every 2-3 days for early signs of disease.',\n","            'Maintain rearing house humidity at 70-85% to prevent fungal onset.',\n","            'Harvest leaves in the early morning for maximum freshness.'\n","        ]\n","    },\n","    'Leaf Rust': {\n","        'status'  : '⚠️ LEAF RUST DETECTED',\n","        'color'   : 'darkorange',\n","        'summary' : 'Leaf Rust (Cerotelium fici fungus) detected. Reduces silkworm health and cocoon quality.',\n","        'actions' : [\n","            'IMMEDIATE: Remove and destroy all visibly infected leaves.',\n","            'Do NOT feed rust-affected leaves to silkworms.',\n","            'Spray Mancozeb (0.2%) or Wettable Sulphur (0.3%) on affected plants.',\n","            'Improve air circulation — avoid dense planting.',\n","            'Reduce overhead irrigation; water at base only.',\n","            'Repeat fungicide spray after 10-12 days if infection persists.',\n","            'Disinfect rearing trays with 2% bleaching powder solution.'\n","        ]\n","    },\n","    'Leaf spot': {\n","        'status'  : '🔴 LEAF SPOT DETECTED',\n","        'color'   : 'red',\n","        'summary' : 'Leaf Spot (Pseudocercospora mori) detected. Spotted leaves are toxic to silkworms.',\n","        'actions' : [\n","            'IMMEDIATE: Stop feeding spotted leaves to silkworms completely.',\n","            'Remove infected leaves and burn them — do not compost.',\n","            'Apply Carbendazim (0.1%) or Copper Oxychloride (0.3%) spray.',\n","            'Ensure proper drainage — stagnant water worsens this disease.',\n","            'Maintain spacing between plants for better airflow.',\n","            'Check silkworms for Flacherie symptoms if spotted leaves were fed recently.',\n","            'Repeat spray every 15 days during monsoon season.'\n","        ]\n","    }\n","}\n","\n","def predict_and_advise(img_path):\n","    img = image.load_img(img_path, target_size=(224, 224))\n","    img_array = image.img_to_array(img) / 255.0\n","    img_array = np.expand_dims(img_array, axis=0)\n","\n","    predictions = model.predict(img_array, verbose=0)\n","    confidence  = np.max(predictions) * 100\n","    class_idx   = np.argmax(predictions)\n","    class_name  = CLASS_NAMES[class_idx]\n","    advice      = TREATMENT_ADVICE[class_name]\n","\n","    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))\n","\n","    ax1.imshow(mpimg.imread(img_path))\n","    ax1.set_title(\"Input Leaf Image\", fontsize=12)\n","    ax1.axis('off')\n","\n","    ax2.axis('off')\n","    result_text = (\n","        f\"{advice['status']}\\n\"\n","        f\"{'─'*45}\\n\"\n","        f\"Predicted Class : {class_name}\\n\"\n","        f\"Confidence      : {confidence:.1f}%\\n\\n\"\n","        f\"Summary:\\n{advice['summary']}\\n\\n\"\n","        f\"Recommended Actions:\\n\"\n","    )\n","    for i, action in enumerate(advice['actions'], 1):\n","        result_text += f\"  {i}. {action}\\n\"\n","\n","    ax2.text(0.02, 0.98, result_text,\n","             transform=ax2.transAxes,\n","             fontsize=9,\n","             verticalalignment='top',\n","             fontfamily='monospace',\n","             color=advice['color'],\n","             bbox=dict(boxstyle='round', facecolor='#f9f9f9', alpha=0.8))\n","\n","    plt.suptitle('🌿 Mulberry Leaf Disease Advisory System', fontsize=14, fontweight='bold')\n","    plt.tight_layout()\n","    plt.show()\n","    return class_name, confidence\n","\n","# Test on one image from each class\n","print(\"Testing on sample images from each class...\\n\")\n","for cls in CLASS_NAMES:\n","    folder = os.path.join(DATA_PATH, cls)\n","    sample = random.choice([f for f in os.listdir(folder)\n","                            if f.lower().endswith(('.jpg','.jpeg','.png'))])\n","    predicted_class, conf = predict_and_advise(os.path.join(folder, sample))\n","    print(f\"Actual: {cls:25s} → Predicted: {predicted_class:25s} ({conf:.1f}%)\\n\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"o0DQHeQhLTuJ"},"outputs":[],"source":["# CELL 9 — Save model to Google Drive so it persists\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","# Save model\n","model.save('/content/drive/MyDrive/mulberry_disease_model.h5')\n","\n","# Save class names\n","import json\n","with open('/content/drive/MyDrive/class_names.json', 'w') as f:\n","    json.dump(CLASS_NAMES, f)\n","\n","print(\"✅ Model saved to Google Drive!\")\n","print(\"   Next session: just load it — no retraining needed.\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"7UmA2IPWLVM3"},"outputs":[],"source":["# CELL 10 — Fine-tuning: unfreeze top layers of MobileNetV2\n","print(\"🔧 Starting fine-tuning...\\n\")\n","\n","# Unfreeze the last 30 layers of the base model\n","base_model.trainable = True\n","for layer in base_model.layers[:-30]:\n","    layer.trainable = False\n","\n","# Recompile with very low learning rate\n","model.compile(\n","    optimizer=tf.keras.optimizers.Adam(learning_rate=1e-5),\n","    loss='categorical_crossentropy',\n","    metrics=['accuracy']\n",")\n","\n","trainable_count = sum([tf.size(w).numpy() for w in model.trainable_weights])\n","print(f\"✅ Fine-tuning: {trainable_count:,} trainable params (top 30 layers unfrozen)\")\n","\n","# Re-train with same generators\n","callbacks_ft = [\n","    EarlyStopping(patience=5, restore_best_weights=True, verbose=1),\n","    ReduceLROnPlateau(factor=0.5, patience=2, verbose=1)\n","]\n","\n","history_ft = model.fit(\n","    train_gen,\n","    validation_data=val_gen,\n","    epochs=15,\n","    callbacks=callbacks_ft\n",")\n","\n","print(\"\\n✅ Fine-tuning complete!\")\n","\n","# Check final validation accuracy\n","final_val_acc = max(history_ft.history['val_accuracy']) * 100\n","print(f\"   Best validation accuracy after fine-tuning: {final_val_acc:.1f}%\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"A-wakkEMNxC2"},"outputs":[],"source":["# CELL 11 — Save fine-tuned model to Google Drive\n","model.save('/content/drive/MyDrive/mulberry_disease_model_finetuned.h5')\n","print(\"✅ Fine-tuned model saved to Google Drive!\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":56,"status":"ok","timestamp":1785383538107,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"GvfOtQwpcn7B","outputId":"77e1cb95-5f17-424a-e7b6-084b6d41b9ee"},"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Module 1: Deep Disease Knowledge Base loaded!\n","   Diseases covered: ['Disease Free leaves', 'Leaf Rust', 'Leaf spot']\n"]}],"source":["# CELL 12 — MODULE 1: Deep Disease Knowledge Base\n","# Each disease has: symptoms, cause, severity, chemical,\n","# actions, prevention, silkworm impact\n","\n","DISEASE_KNOWLEDGE = {\n","\n","    'Disease Free leaves': {\n","        'status'         : '✅ HEALTHY LEAF',\n","        'severity'       : 'NONE',\n","        'cause'          : 'No pathogen detected',\n","        'symptoms'       : [\n","            'Uniform bright green colour across the entire leaf',\n","            'No spots, patches, rust marks or discolouration',\n","            'Smooth leaf surface with no powdery coating',\n","            'Strong leaf veins with no yellowing at margins'\n","        ],\n","        'silkworm_impact': 'SAFE — Healthy leaves provide full nutritional value. '\n","                           'Silkworms fed on healthy leaves show better growth, '\n","                           'higher cocoon weight, and stronger silk thread quality.',\n","        'chemical'       : 'None required',\n","        'dosage'         : 'N/A',\n","        'frequency'      : 'N/A',\n","        'immediate_actions': [\n","            'Continue feeding these leaves to silkworms — they are fully safe',\n","            'Harvest in early morning (6–8 AM) when leaf moisture is optimal',\n","            'Store harvested leaves in a cool, damp cloth to retain freshness',\n","            'Use within 4–6 hours of harvest for best silkworm feeding results'\n","        ],\n","        'prevention'     : [\n","            'Inspect leaves every 2–3 days to catch early disease signs',\n","            'Maintain proper spacing between mulberry plants for airflow',\n","            'Apply balanced NPK fertiliser (100:50:50 kg/hectare/year)',\n","            'Keep garden free of weeds that harbour disease-causing organisms',\n","            'Avoid overhead irrigation — water at base of plants only'\n","        ]\n","    },\n","\n","    'Leaf Rust': {\n","        'status'         : '⚠️ LEAF RUST DETECTED',\n","        'severity'       : 'MODERATE',\n","        'cause'          : 'Fungal pathogen: Cerotelium fici (Obligate parasite)',\n","        'symptoms'       : [\n","            'Small orange-yellow pustules (uredia) on underside of leaf',\n","            'Corresponding yellow spots visible on upper leaf surface',\n","            'Premature yellowing and early leaf drop in severe cases',\n","            'Powdery rust-coloured spore masses on leaf underside',\n","            'Leaf distortion and curling in advanced infection'\n","        ],\n","        'silkworm_impact': 'DANGEROUS — Rust-affected leaves reduce silkworm appetite '\n","                           'by 30–40%. Severely infected leaves cause digestive disorders, '\n","                           'reduce cocoon weight by up to 25%, and weaken silk thread strength. '\n","                           'DO NOT feed rust-infected leaves to silkworms.',\n","        'chemical'       : 'Mancozeb 75% WP (Dithane M-45) or Wettable Sulphur 80% WP',\n","        'dosage'         : 'Mancozeb: 2g per litre of water | Wettable Sulphur: 3g per litre',\n","        'frequency'      : 'Spray every 10–12 days. Minimum 3 sprays per season. '\n","                           'Stop spraying 7 days before leaf harvest.',\n","        'immediate_actions': [\n","            'IMMEDIATELY stop feeding rust-affected leaves to silkworms',\n","            'Remove and destroy (burn) all visibly infected leaves today',\n","            'Do NOT compost infected leaves — spores will survive and spread',\n","            'Spray Mancozeb 2g/L on all plants including healthy ones nearby',\n","            'Disinfect rearing trays and tools with 2% bleaching powder solution',\n","            'Isolate infected section of garden from healthy plants if possible'\n","        ],\n","        'prevention'     : [\n","            'Apply preventive Mancozeb spray at start of monsoon season',\n","            'Maintain plant spacing of at least 90cm × 90cm for airflow',\n","            'Avoid excess nitrogen fertiliser — it promotes lush growth susceptible to rust',\n","            'Remove and burn crop debris after each harvest season',\n","            'Plant rust-resistant mulberry varieties: S-146, MR-2, Victory-1',\n","            'Monitor garden weekly especially during humid/rainy weather'\n","        ]\n","    },\n","\n","    'Leaf spot': {\n","        'status'         : '🔴 LEAF SPOT DETECTED',\n","        'severity'       : 'HIGH',\n","        'cause'          : 'Fungal pathogens: Pseudocercospora mori or Cercospora moricola',\n","        'symptoms'       : [\n","            'Circular to irregular brown/grey spots with dark brown margins',\n","            'Spots range from 2–15mm in diameter on upper leaf surface',\n","            'Yellow halo surrounding spots in early infection stage',\n","            'Spots coalesce (merge) into large necrotic patches in severe cases',\n","            'Premature defoliation (leaf drop) weakening the mulberry plant',\n","            'Grey powdery fungal growth visible in centre of spots under magnification'\n","        ],\n","        'silkworm_impact': 'CRITICAL DANGER — Leaf spot toxins directly harm silkworm '\n","                           'digestive system. Feeding spotted leaves causes Flacherie '\n","                           '(bacterial gut disease) in silkworms, leading to mass mortality. '\n","                           'Even 10% spotted leaves mixed with healthy leaves can trigger '\n","                           'an outbreak. NEVER feed spotted leaves under any circumstances.',\n","        'chemical'       : 'Carbendazim 50% WP (Bavistin) or Copper Oxychloride 50% WP',\n","        'dosage'         : 'Carbendazim: 1g per litre of water | '\n","                           'Copper Oxychloride: 3g per litre of water',\n","        'frequency'      : 'Spray every 15 days during monsoon. '\n","                           'Minimum 4 sprays per season. '\n","                           'Stop spraying 10 days before leaf harvest for silkworm safety.',\n","        'immediate_actions': [\n","            'IMMEDIATELY stop all leaf feeding from infected plants',\n","            'Remove and BURN infected leaves — do not leave on ground',\n","            'Spray Carbendazim 1g/L on all plants including surrounding healthy ones',\n","            'Check silkworms for Flacherie symptoms if spotted leaves were already fed',\n","            'Disinfect entire rearing house with 2% formalin solution',\n","            'Apply fresh lime powder on rearing house floor',\n","            'Do not harvest from infected plants for minimum 15 days after treatment'\n","        ],\n","        'prevention'     : [\n","            'Apply Copper Oxychloride preventively before monsoon onset',\n","            'Ensure proper drainage — stagnant water around roots worsens infection',\n","            'Remove and burn all infected plant debris after each season',\n","            'Maintain garden hygiene — remove weeds which host fungal spores',\n","            'Avoid wetting leaves during irrigation — drip irrigation preferred',\n","            'Plant disease-tolerant varieties: S-1635, G-2, MR-2 for high-rainfall zones'\n","        ]\n","    }\n","}\n","\n","print(\"✅ Module 1: Deep Disease Knowledge Base loaded!\")\n","print(f\"   Diseases covered: {list(DISEASE_KNOWLEDGE.keys())}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":36,"status":"ok","timestamp":1785383544382,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"9n23PefI39kc","outputId":"b8b66f3b-aff9-4aa9-fad3-8da990a4a50f"},"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Module 1 prediction function ready (with confidence threshold)!\n"]}],"source":["# CELL 13 — MODULE 1: Disease Prediction + Deep Report (with Confidence Threshold)\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import matplotlib.image as mpimg\n","from tensorflow.keras.preprocessing import image as keras_image\n","\n","CONFIDENCE_THRESHOLD = 60.0  # below this %, we flag result as uncertain\n","\n","def predict_disease(img_path):\n","    \"\"\"\n","    Takes a leaf image path\n","    Returns full deep disease report\n","    \"\"\"\n","    # Load and preprocess\n","    img = keras_image.load_img(img_path, target_size=(224, 224))\n","    img_array = keras_image.img_to_array(img) / 255.0\n","    img_array = np.expand_dims(img_array, axis=0)\n","\n","    # Predict\n","    preds = model.predict(img_array, verbose=0)\n","    confidence_scores = {CLASS_NAMES[i]: float(preds[0][i])*100 for i in range(len(CLASS_NAMES))}\n","    predicted_class = max(confidence_scores, key=confidence_scores.get)\n","    confidence = confidence_scores[predicted_class]\n","\n","    # ── CONFIDENCE THRESHOLD CHECK ─────────────────────────\n","    is_uncertain = confidence < CONFIDENCE_THRESHOLD\n","\n","    if is_uncertain:\n","        info = {\n","            'severity': 'Unknown',\n","            'status': '⚠️ Uncertain — please retake photo',\n","            'cause': 'The model could not classify this image with sufficient confidence. This usually happens with blurry photos, poor lighting, non-leaf objects, or leaves with damage the model was not trained on.',\n","            'symptoms': ['Confidence below safe threshold (60%)'],\n","            'silkworm_impact': 'Do not act on this result. Retake the photo in good natural light, with the leaf filling most of the frame, against a plain background.',\n","            'chemical': 'N/A',\n","            'dosage': 'N/A',\n","            'frequency': 'N/A',\n","            'immediate_actions': [\n","                'Retake photo in better lighting',\n","                'Ensure only one leaf is in frame',\n","                'Avoid shadows and blur'\n","            ],\n","            'prevention': [\n","                'Use daylight, not artificial light',\n","                'Hold camera steady, leaf flat'\n","            ]\n","        }\n","    else:\n","        info = DISEASE_KNOWLEDGE[predicted_class]\n","\n","    # ── Display ───────────────────────────────────────────\n","    fig = plt.figure(figsize=(18, 11))\n","    fig.patch.set_facecolor('#f8f9fa')\n","\n","    # Leaf image\n","    ax_img = fig.add_axes([0.01, 0.20, 0.25, 0.65])\n","    ax_img.imshow(mpimg.imread(img_path))\n","    ax_img.set_title('📸 Uploaded Leaf', fontsize=11, fontweight='bold')\n","    ax_img.axis('off')\n","\n","    # Confidence bar chart\n","    ax_bar = fig.add_axes([0.01, 0.05, 0.25, 0.13])\n","    colors = ['green' if c == predicted_class else 'lightgray' for c in CLASS_NAMES]\n","    bars = ax_bar.barh(CLASS_NAMES,\n","                       [confidence_scores[c] for c in CLASS_NAMES],\n","                       color=colors)\n","    ax_bar.set_xlabel('Confidence %', fontsize=8)\n","    ax_bar.set_title('Prediction Scores', fontsize=9, fontweight='bold')\n","    for bar, cls in zip(bars, CLASS_NAMES):\n","        ax_bar.text(bar.get_width() + 0.5, bar.get_y() + bar.get_height()/2,\n","                   f'{confidence_scores[cls]:.1f}%', va='center', fontsize=8)\n","    ax_bar.set_xlim(0, 115)\n","\n","    # Deep report\n","    ax_rep = fig.add_axes([0.28, 0.02, 0.70, 0.96])\n","    ax_rep.axis('off')\n","\n","    severity_color_map = {'NONE':'green', 'MODERATE':'orange', 'HIGH':'red', 'None':'green',\n","                          'Moderate':'orange', 'High':'red', 'Unknown':'gray'}\n","    severity_color = severity_color_map.get(info['severity'], 'gray')\n","\n","    report = (\n","        f\"{'='*62}\\n\"\n","        f\"  🌿 MODULE 1: MULBERRY LEAF DISEASE ANALYSIS REPORT\\n\"\n","        f\"{'='*62}\\n\"\n","        f\"  Result   : {info['status']}\\n\"\n","        f\"  Confidence: {confidence:.1f}%\\n\"\n","        f\"  Severity : {info['severity']}\\n\"\n","        f\"  Cause    : {info['cause']}\\n\\n\"\n","\n","        f\"── SYMPTOMS OBSERVED ─────────────────────────────────────\\n\"\n","    )\n","    for i, s in enumerate(info['symptoms'], 1):\n","        report += f\"  {i}. {s}\\n\"\n","\n","    report += (\n","        f\"\\n── SILKWORM IMPACT IF FED ────────────────────────────────\\n\"\n","        f\"  {info['silkworm_impact']}\\n\"\n","\n","        f\"\\n── CHEMICAL TREATMENT ────────────────────────────────────\\n\"\n","        f\"  Chemical  : {info['chemical']}\\n\"\n","        f\"  Dosage    : {info['dosage']}\\n\"\n","        f\"  Frequency : {info['frequency']}\\n\"\n","\n","        f\"\\n── IMMEDIATE ACTIONS (Do Today) ──────────────────────────\\n\"\n","    )\n","    for i, a in enumerate(info['immediate_actions'], 1):\n","        report += f\"  {i}. {a}\\n\"\n","\n","    report += f\"\\n── PREVENTION STEPS ──────────────────────────────────────\\n\"\n","    for i, p in enumerate(info['prevention'], 1):\n","        report += f\"  {i}. {p}\\n\"\n","\n","    report += f\"{'='*62}\"\n","\n","    ax_rep.text(0.01, 0.99, report,\n","                transform=ax_rep.transAxes,\n","                fontsize=8, verticalalignment='top',\n","                fontfamily='monospace',\n","                bbox=dict(boxstyle='round,pad=0.6',\n","                          facecolor='white',\n","                          edgecolor=severity_color,\n","                          linewidth=2.5))\n","\n","    plt.suptitle('🌿 AI-Based Sericulture Leaf Disease Detection System',\n","                 fontsize=13, fontweight='bold', y=0.99)\n","    plt.show()\n","    print(report)\n","    return predicted_class, confidence, info['severity']\n","\n","print(\"✅ Module 1 prediction function ready (with confidence threshold)!\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":28,"status":"ok","timestamp":1785383549847,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"6fS8Pqs8u_OO","outputId":"595a3863-acb7-4666-9a8b-e8774e813688"},"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Using last conv layer for Grad-CAM: Conv_1\n","✅ Grad-CAM functions ready! Test with: show_gradcam_for_image('/path/to/leaf.jpg')\n"]}],"source":["# CELL 13B — Grad-CAM Explainability (shows WHERE the AI looked on the leaf)\n","import cv2\n","import tensorflow as tf\n","\n","def get_last_conv_layer_name(m):\n","    \"\"\"Auto-detect the last Conv2D layer inside the model (works even if MobileNetV2 is nested).\"\"\"\n","    for layer in reversed(m.layers):\n","        if isinstance(layer, tf.keras.layers.Conv2D):\n","            return layer.name\n","        if hasattr(layer, 'layers'):\n","            for sub in reversed(layer.layers):\n","                if isinstance(sub, tf.keras.layers.Conv2D):\n","                    return sub.name\n","    raise ValueError(\"No Conv2D layer found in model\")\n","\n","LAST_CONV_LAYER = get_last_conv_layer_name(model)\n","print(f\"✅ Using last conv layer for Grad-CAM: {LAST_CONV_LAYER}\")\n","\n","def make_gradcam_heatmap(img_array, model, last_conv_layer_name, pred_index=None):\n","    grad_model = tf.keras.models.Model(\n","        [model.inputs],\n","        [model.get_layer(last_conv_layer_name).output, model.output]\n","    )\n","    with tf.GradientTape() as tape:\n","        conv_outputs, predictions = grad_model(img_array)\n","        if pred_index is None:\n","            pred_index = tf.argmax(predictions[0])\n","        class_channel = predictions[:, pred_index]\n","\n","    grads = tape.gradient(class_channel, conv_outputs)\n","    pooled_grads = tf.reduce_mean(grads, axis=(0, 1, 2))\n","    conv_outputs = conv_outputs[0]\n","    heatmap = conv_outputs @ pooled_grads[..., tf.newaxis]\n","    heatmap = tf.squeeze(heatmap)\n","    heatmap = tf.maximum(heatmap, 0) / (tf.math.reduce_max(heatmap) + 1e-8)\n","    return heatmap.numpy()\n","\n","def overlay_gradcam(img_array_uint8, heatmap, alpha=0.4):\n","    \"\"\"img_array_uint8 must be an RGB numpy array, values 0-255, shape (H, W, 3).\"\"\"\n","    img = cv2.resize(img_array_uint8.astype('uint8'), (224, 224))\n","\n","    heatmap_resized = cv2.resize(heatmap, (224, 224))\n","    heatmap_uint8 = np.uint8(255 * heatmap_resized)\n","    heatmap_color = cv2.applyColorMap(heatmap_uint8, cv2.COLORMAP_JET)\n","    heatmap_color = cv2.cvtColor(heatmap_color, cv2.COLOR_BGR2RGB)\n","\n","    overlayed = cv2.addWeighted(img, 1 - alpha, heatmap_color, alpha, 0)\n","    return overlayed\n","\n","def show_gradcam_for_image(img_path):\n","    \"\"\"Quick test helper — run this in Colab to preview Grad-CAM on any leaf photo.\"\"\"\n","    img = keras_image.load_img(img_path, target_size=(224, 224))\n","    img_array_raw = keras_image.img_to_array(img)  # 0-255\n","    img_array_norm = np.expand_dims(img_array_raw / 255.0, axis=0)\n","\n","    preds = model.predict(img_array_norm, verbose=0)\n","    pred_index = int(np.argmax(preds[0]))\n","\n","    heatmap = make_gradcam_heatmap(img_array_norm, model, LAST_CONV_LAYER, pred_index)\n","    overlayed = overlay_gradcam(img_array_raw, heatmap)\n","\n","    fig, axes = plt.subplots(1, 2, figsize=(10, 5))\n","    axes[0].imshow(img_array_raw.astype('uint8'))\n","    axes[0].set_title('Original Leaf')\n","    axes[0].axis('off')\n","    axes[1].imshow(overlayed)\n","    axes[1].set_title(f'Grad-CAM: {CLASS_NAMES[pred_index]}')\n","    axes[1].axis('off')\n","    plt.show()\n","\n","print(\"✅ Grad-CAM functions ready! Test with: show_gradcam_for_image('/path/to/leaf.jpg')\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":31,"status":"ok","timestamp":1785383555100,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"MNgJc8W-qpe1","outputId":"f414e877-491f-4ccc-99a2-88f9419386ae"},"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Module 2: Silkworm Climate Advisory loaded!\n"]}],"source":["  # CELL 14 — MODULE 2: Silkworm Rearing Climate Advisory\n","# Completely separate from leaf disease\n","# Checks if rearing house temp/humidity is safe for silkworms\n","\n","SILKWORM_CLIMATE = {\n","    'Egg / Incubation': {\n","        'temp_min': 24, 'temp_max': 25,\n","        'humidity_min': 80, 'humidity_max': 85,\n","        'growth_stage': 'Egg hatching stage',\n","        'too_hot'    : 'Above 26°C causes premature/abnormal hatching and egg desiccation',\n","        'too_cold'   : 'Below 23°C delays hatching by 2–4 days and weakens hatchlings',\n","        'too_humid'  : 'Above 90% RH promotes fungal growth on eggs causing mass death',\n","        'too_dry'    : 'Below 75% RH causes egg shell hardening and failed hatching'\n","    },\n","    'Instar 1': {\n","        'temp_min': 26, 'temp_max': 28,\n","        'humidity_min': 85, 'humidity_max': 90,\n","        'growth_stage': 'First larval stage — most delicate period',\n","        'too_hot'    : 'Above 29°C causes heat stress, reduced feeding, higher mortality',\n","        'too_cold'   : 'Below 25°C severely slows growth, increases moulting time by 1–2 days',\n","        'too_humid'  : 'Above 92% RH promotes Flacherie bacterial infection',\n","        'too_dry'    : 'Below 80% RH causes dehydration and poor leaf consumption'\n","    },\n","    'Instar 2': {\n","        'temp_min': 26, 'temp_max': 28,\n","        'humidity_min': 85, 'humidity_max': 90,\n","        'growth_stage': 'Second larval stage — rapid growth period',\n","        'too_hot'    : 'Above 29°C triggers early moulting with incomplete development',\n","        'too_cold'   : 'Below 25°C reduces silk gland development significantly',\n","        'too_humid'  : 'Above 92% increases risk of Muscardine fungal disease',\n","        'too_dry'    : 'Below 80% RH causes poor skin shedding during moult'\n","    },\n","    'Instar 3': {\n","        'temp_min': 25, 'temp_max': 27,\n","        'humidity_min': 80, 'humidity_max': 85,\n","        'growth_stage': 'Third larval stage — silk gland development begins',\n","        'too_hot'    : 'Above 28°C causes increased respiration and energy waste',\n","        'too_cold'   : 'Below 24°C slows silk protein synthesis in glands',\n","        'too_humid'  : 'Above 87% RH increases Flacherie and Pebrine risk',\n","        'too_dry'    : 'Below 75% RH causes reduced leaf intake affecting silk yield'\n","    },\n","    'Instar 4': {\n","        'temp_min': 23, 'temp_max': 26,\n","        'humidity_min': 70, 'humidity_max': 80,\n","        'growth_stage': 'Fourth larval stage — intensive silk protein accumulation',\n","        'too_hot'    : 'Above 28°C denatures silk proteins, reducing thread strength',\n","        'too_cold'   : 'Below 22°C causes sluggish movement and poor food conversion',\n","        'too_humid'  : 'Above 85% RH strongly promotes Grasserie viral disease',\n","        'too_dry'    : 'Below 65% RH causes physical stress and body weight loss'\n","    },\n","    'Instar 5': {\n","        'temp_min': 22, 'temp_max': 25,\n","        'humidity_min': 65, 'humidity_max': 75,\n","        'growth_stage': 'Final larval stage — maximum silk accumulation before spinning',\n","        'too_hot'    : 'Above 26°C causes restlessness, early spinning with poor cocoon quality',\n","        'too_cold'   : 'Below 21°C delays spinning by 1–2 days, thin cocoon shell',\n","        'too_humid'  : 'Above 80% RH is the leading cause of Flacherie in late instars',\n","        'too_dry'    : 'Below 60% RH causes silk thread breakage during spinning'\n","    }\n","}\n","\n","def silkworm_climate_check(stage, temp, humidity):\n","    \"\"\"\n","    Checks if rearing house conditions are safe for silkworms\n","    at a specific instar stage\n","    \"\"\"\n","    rule = SILKWORM_CLIMATE[stage]\n","    issues = []\n","    consequences = []\n","    corrections = []\n","    status = 'SAFE'\n","\n","    # Temperature check\n","    if temp < rule['temp_min']:\n","        diff = round(rule['temp_min'] - temp, 1)\n","        issues.append(f\"Temperature {diff}°C BELOW ideal range\")\n","        consequences.append(rule['too_cold'])\n","        corrections.append(\n","            f\"Increase AC/heater setpoint by {diff}°C \"\n","            f\"→ Target: {rule['temp_min']}–{rule['temp_max']}°C\"\n","        )\n","        status = 'WARNING' if diff <= 2 else 'CRITICAL'\n","\n","    elif temp > rule['temp_max']:\n","        diff = round(temp - rule['temp_max'], 1)\n","        issues.append(f\"Temperature {diff}°C ABOVE ideal range\")\n","        consequences.append(rule['too_hot'])\n","        corrections.append(\n","            f\"Decrease AC setpoint by {diff}°C \"\n","            f\"→ Target: {rule['temp_min']}–{rule['temp_max']}°C\"\n","        )\n","        status = 'WARNING' if diff <= 2 else 'CRITICAL'\n","\n","    # Humidity check\n","    if humidity < rule['humidity_min']:\n","        diff = round(rule['humidity_min'] - humidity, 1)\n","        issues.append(f\"Humidity {diff}% BELOW ideal range\")\n","        consequences.append(rule['too_dry'])\n","        corrections.append(\n","            f\"Increase humidity by {diff}% → Use humidifier or wet jute cloth \"\n","            f\"→ Target: {rule['humidity_min']}–{rule['humidity_max']}% RH\"\n","        )\n","        if status != 'CRITICAL':\n","            status = 'WARNING' if diff <= 5 else 'CRITICAL'\n","\n","    elif humidity > rule['humidity_max']:\n","        diff = round(humidity - rule['humidity_max'], 1)\n","        issues.append(f\"Humidity {diff}% ABOVE ideal range\")\n","        consequences.append(rule['too_humid'])\n","        corrections.append(\n","            f\"Decrease humidity by {diff}% → Open ventilation/exhaust fan \"\n","            f\"→ Target: {rule['humidity_min']}–{rule['humidity_max']}% RH\"\n","        )\n","        if status != 'CRITICAL':\n","            status = 'WARNING' if diff <= 5 else 'CRITICAL'\n","\n","    # Print report\n","    icon = {'SAFE': '✅', 'WARNING': '⚠️', 'CRITICAL': '🔴'}[status]\n","    print(\"=\"*62)\n","    print(f\"  🐛 MODULE 2: SILKWORM CLIMATE ADVISORY REPORT\")\n","    print(\"=\"*62)\n","    print(f\"  Stage            : {stage} ({rule['growth_stage']})\")\n","    print(f\"  Current Temp     : {temp}°C\")\n","    print(f\"  Current Humidity : {humidity}% RH\")\n","    print(f\"  Ideal Temp Range : {rule['temp_min']}–{rule['temp_max']}°C\")\n","    print(f\"  Ideal Humidity   : {rule['humidity_min']}–{rule['humidity_max']}% RH\")\n","    print(f\"  Status           : {icon} {status}\")\n","    print(\"-\"*62)\n","\n","    if status == 'SAFE':\n","        print(\"  ✅ All conditions are within ideal range for this instar.\")\n","        print(f\"  💡 Silkworms at {stage} are growing under optimal conditions.\")\n","    else:\n","        print(\"  ⚠️  Issues Detected:\")\n","        for i, issue in enumerate(issues):\n","            print(f\"    {i+1}. {issue}\")\n","        print(\"\\n  🐛 Impact on Silkworms if Not Corrected:\")\n","        for i, cons in enumerate(consequences):\n","            print(f\"    {i+1}. {cons}\")\n","        print(\"\\n  🔧 Exact Corrections Needed:\")\n","        for i, corr in enumerate(corrections):\n","            print(f\"    {i+1}. {corr}\")\n","    print(\"=\"*62)\n","    return status\n","\n","print(\"✅ Module 2: Silkworm Climate Advisory loaded!\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"9tQg8cFIqshz"},"outputs":[],"source":["# CELL 15 — MODULE 3: Silkworm Disease Checker\n","# Farmer selects symptoms → rule-based diagnosis\n","# Covers: Grasserie, Flacherie, Muscardine, Pebrine\n","\n","SILKWORM_DISEASES = {\n","    'Grasserie': {\n","        'also_known_as': 'Nuclear Polyhedrosis Virus (NPV)',\n","        'type'         : 'Viral Disease',\n","        'severity'     : 'CRITICAL',\n","        'symptoms'     : [\n","            'body_swollen',\n","            'skin_shiny',\n","            'body_yellowish',\n","            'sluggish_movement',\n","            'liquid_oozing'\n","        ],\n","        'description'  : 'Most destructive viral disease of silkworm. '\n","                         'Caused by Bombyx mori Nuclear Polyhedrosis Virus (BmNPV). '\n","                         'Spreads rapidly through contaminated leaves and rearing equipment.',\n","        'visible_signs': [\n","            'Body becomes swollen and bloated',\n","            'Skin appears shiny and translucent (you can almost see through)',\n","            'Body turns yellowish-white colour',\n","            'Sluggish movement, stops eating, hangs on tray edges',\n","            'Liquid oozes out when body is pressed — highly infectious',\n","            'Death within 2–5 days of visible symptoms'\n","        ],\n","        'spread'       : 'Spreads through infected leaf, contaminated tools, '\n","                         'rearing trays, and physical contact between silkworms',\n","        'treatment'    : [\n","            'NO CURE exists for Grasserie — prevention is the only strategy',\n","            'IMMEDIATELY remove and destroy all infected silkworms by burning',\n","            'Disinfect rearing trays with 2% formalin solution for 30 minutes',\n","            'Spray 0.5% bleaching powder solution on rearing house floor and walls',\n","            'Wash hands thoroughly before handling healthy silkworms',\n","            'Apply Vijetha (BmNPV antiviral) spray on remaining healthy worms if available'\n","        ],\n","        'prevention'   : [\n","            'Disinfect rearing house with 2% formalin 48 hours before each batch',\n","            'Use only disease-free layings (DFLs) certified by Silk Board',\n","            'Never mix different age groups of silkworms in same rearing space',\n","            'Apply 500ppm chlorine solution on mulberry leaves before feeding',\n","            'Maintain strict hygiene — change clothes before entering rearing house',\n","            'Remove dead/sick worms daily and burn immediately'\n","        ],\n","        'mortality'    : 'Up to 80–100% if not controlled within 48 hours'\n","    },\n","\n","    'Flacherie': {\n","        'also_known_as': 'Infectious Flacherie Virus (IFV) + Bacterial',\n","        'type'         : 'Viral + Bacterial Disease',\n","        'severity'     : 'HIGH',\n","        'symptoms'     : [\n","            'soft_body',\n","            'dark_patches',\n","            'foul_smell',\n","            'loose_droppings',\n","            'less_movement'\n","        ],\n","        'description'  : 'Combined viral and bacterial disease. '\n","                         'Triggered by poor rearing conditions — high humidity, '\n","                         'contaminated leaves, and overcrowding. '\n","                         'Most common in late instar silkworms.',\n","        'visible_signs': [\n","            'Body becomes soft and flaccid (no firmness when touched)',\n","            'Dark brownish patches appear on body surface',\n","            'Foul/sour smell from infected silkworms',\n","            'Loose, watery droppings instead of firm pellets',\n","            'Reduced movement, stops climbing to tray edges',\n","            'Body collapses and liquefies within 24–48 hours of death'\n","        ],\n","        'spread'       : 'Spreads through contaminated droppings, '\n","                         'infected leaves, poor ventilation and humidity above 85%',\n","        'treatment'    : [\n","            'Remove all infected worms immediately and destroy by burning',\n","            'Reduce rearing house humidity to below 75% immediately',\n","            'Apply Resham Keet Oushadh (RKO) antibiotic at 200mg per litre of water — spray on leaves',\n","            'Sprinkle slaked lime (calcium hydroxide) powder on rearing beds',\n","            'Disinfect rearing house with Sanitech solution (1% formaldehyde)',\n","            'Improve ventilation — open windows and use exhaust fans'\n","        ],\n","        'prevention'   : [\n","            'Never feed disease-affected or wilted mulberry leaves',\n","            'Maintain humidity below 85% especially for Instar 4 and 5',\n","            'Ensure adequate spacing between silkworms on rearing trays',\n","            'Clean and disinfect rearing equipment after every batch',\n","            'Apply 2g slaked lime per tray daily to absorb moisture from droppings',\n","            'Avoid sudden temperature fluctuations in rearing house'\n","        ],\n","        'mortality'    : '30–60% mortality if not treated within 24 hours'\n","    },\n","\n","    'Muscardine': {\n","        'also_known_as': 'White Muscardine / Green Muscardine',\n","        'type'         : 'Fungal Disease',\n","        'severity'     : 'HIGH',\n","        'symptoms'     : [\n","            'white_powder_on_body',\n","            'body_hard',\n","            'abnormal_posture',\n","            'green_powder_on_body',\n","            'mummified_body'\n","        ],\n","        'description'  : 'Fungal disease caused by Beauveria bassiana (White) '\n","                         'or Nomuraea rileyi (Green). '\n","                         'Thrives in cool and moist conditions. '\n","                         'Silkworm body becomes mummified after death.',\n","        'visible_signs': [\n","            'White or green powdery coating on body surface',\n","            'Body becomes rigid and hard like stone when pressed',\n","            'Abnormal body posture — bent or twisted position',\n","            'Mummified (dried, hard) corpse after death',\n","            'White or green fungal growth spreading from body',\n","            'Infected worms stop feeding and become immobile'\n","        ],\n","        'spread'       : 'Fungal spores spread through air, contaminated rearing equipment, '\n","                         'and direct contact. Spreads rapidly in cool, humid conditions.',\n","        'treatment'    : [\n","            'Remove and burn all infected (hard/mummified) silkworms immediately',\n","            'Spray Thiram 75% WP at 3g per litre on rearing house surfaces',\n","            'Apply Bavistin (Carbendazim) 1g per litre on rearing trays',\n","            'Reduce humidity in rearing house below 75% using dehumidifier/exhaust',\n","            'Increase rearing house temperature slightly to reduce fungal growth',\n","            'Disinfect all tools and trays with 5% formalin solution'\n","        ],\n","        'prevention'   : [\n","            'Maintain rearing house temperature above 24°C — fungi dislike warmth',\n","            'Keep humidity below 75% — critical for Muscardine prevention',\n","            'Apply Thiram dust (2g per tray) preventively before each batch',\n","            'Ensure good drainage around rearing house — avoid dampness',\n","            'Use UV light in rearing house periodically to kill airborne fungal spores',\n","            'Disinfect rearing house 72 hours before each batch with Formalin 2%'\n","        ],\n","        'mortality'    : '20–50% in affected batches. Can reach 100% if spores spread'\n","    },\n","\n","    'Pebrine': {\n","        'also_known_as': 'Microsporidiosis',\n","        'type'         : 'Protozoan Disease',\n","        'severity'     : 'CRITICAL',\n","        'symptoms'     : [\n","            'irregular_growth',\n","            'pepper_spots',\n","            'slow_development',\n","            'failure_to_moult',\n","            'uneven_sizes'\n","        ],\n","        'description'  : 'Caused by Nosema bombycis (microsporidian protozoan). '\n","                         'The most feared silkworm disease — it is transmitted '\n","                         'from mother moth to eggs (transovarial transmission). '\n","                         'Cannot be cured once infected.',\n","        'visible_signs': [\n","            'Irregular dark pepper-like spots on body surface',\n","            'Silkworms of same age show very uneven sizes (stunted growth)',\n","            'Failure to moult or abnormal/incomplete moulting',\n","            'Extremely slow development compared to healthy worms',\n","            'Reduced appetite and sluggish behaviour from early instars',\n","            'High mortality rate especially during moulting stage'\n","        ],\n","        'spread'       : 'PRIMARY: From infected mother moth to eggs (vertical transmission). '\n","                         'SECONDARY: Contaminated rearing equipment, infected mulberry leaves '\n","                         'contaminated with silkworm droppings',\n","        'treatment'    : [\n","            'NO TREATMENT available — entire infected batch must be destroyed',\n","            'Burn ALL silkworms, rearing trays, and bedding from infected batch',\n","            'Fumigate rearing house with formaldehyde gas (40% formalin heated)',\n","            'NEVER use eggs from infected moths for next batch',\n","            'Source only certified Disease-Free Layings (DFLs) from Silk Board',\n","            'Report outbreak to nearest Sericulture Department office immediately'\n","        ],\n","        'prevention'   : [\n","            'Use ONLY certified Disease-Free Layings (DFLs) — this is the single most important prevention',\n","            'Microscopic examination of moth crush (mother moth test) before using eggs',\n","            'Disinfect entire rearing house with Sanitech or 2% formalin before each crop',\n","            'Never allow wild silkworms or moths from outside near rearing house',\n","            'Destroy all moths and eggs after each rearing cycle — do not reuse',\n","            'Maintain strict quarantine — do not allow visitors in rearing house'\n","        ],\n","        'mortality'    : 'Can cause 100% crop failure. Entire batch must be destroyed.'\n","    }\n","}\n","\n","# Symptom to disease mapping for diagnosis\n","SYMPTOM_DISEASE_MAP = {\n","    'body_swollen'        : ['Grasserie'],\n","    'skin_shiny'          : ['Grasserie'],\n","    'body_yellowish'      : ['Grasserie'],\n","    'liquid_oozing'       : ['Grasserie'],\n","    'soft_body'           : ['Flacherie'],\n","    'dark_patches'        : ['Flacherie', 'Pebrine'],\n","    'foul_smell'          : ['Flacherie'],\n","    'loose_droppings'     : ['Flacherie'],\n","    'white_powder_on_body': ['Muscardine'],\n","    'green_powder_on_body': ['Muscardine'],\n","    'body_hard'           : ['Muscardine'],\n","    'mummified_body'      : ['Muscardine'],\n","    'abnormal_posture'    : ['Muscardine', 'Grasserie'],\n","    'pepper_spots'        : ['Pebrine'],\n","    'irregular_growth'    : ['Pebrine'],\n","    'slow_development'    : ['Pebrine', 'Flacherie'],\n","    'failure_to_moult'    : ['Pebrine'],\n","    'uneven_sizes'        : ['Pebrine'],\n","    'sluggish_movement'   : ['Grasserie', 'Flacherie'],\n","    'less_movement'       : ['Flacherie', 'Pebrine']\n","}\n","\n","def diagnose_silkworm_disease(selected_symptoms):\n","    \"\"\"\n","    Takes a list of observed symptoms\n","    Returns ranked disease diagnosis with full report\n","    Farmer selects from symptom list, system diagnoses\n","    \"\"\"\n","    # Score each disease\n","    disease_scores = {d: 0 for d in SILKWORM_DISEASES}\n","    for symptom in selected_symptoms:\n","        if symptom in SYMPTOM_DISEASE_MAP:\n","            for disease in SYMPTOM_DISEASE_MAP[symptom]:\n","                disease_scores[disease] += 1\n","\n","    # Rank by score\n","    ranked = sorted(disease_scores.items(), key=lambda x: x[1], reverse=True)\n","    top_disease = ranked[0][0]\n","    top_score = ranked[0][1]\n","\n","    if top_score == 0:\n","        print(\"No matching disease found. Consult a sericulture expert.\")\n","        return None\n","\n","    info = SILKWORM_DISEASES[top_disease]\n","\n","    # Calculate match percentage\n","    total_symptoms_for_disease = len(info['symptoms'])\n","    match_pct = (top_score / total_symptoms_for_disease) * 100\n","\n","    print(\"=\"*62)\n","    print(\"  🐛 MODULE 3: SILKWORM DISEASE DIAGNOSIS REPORT\")\n","    print(\"=\"*62)\n","    print(f\"  Symptoms Selected  : {len(selected_symptoms)}\")\n","    print(f\"  Symptoms Matched   : {top_score}\")\n","    print(f\"\\n  ── TOP DIAGNOSIS ──────────────────────────────────\")\n","    print(f\"  Disease   : {top_disease}\")\n","    print(f\"  Also Known: {info['also_known_as']}\")\n","    print(f\"  Type      : {info['type']}\")\n","    print(f\"  Severity  : {info['severity']}\")\n","    print(f\"  Match     : {match_pct:.0f}% symptom match\")\n","    print(f\"  Mortality : {info['mortality']}\")\n","\n","    if ranked[1][1] > 0:\n","        print(f\"\\n  ── OTHER POSSIBLE DISEASES ────────────────────────\")\n","        for disease, score in ranked[1:]:\n","            if score > 0:\n","                pct = (score / len(SILKWORM_DISEASES[disease]['symptoms'])) * 100\n","                print(f\"  {disease}: {pct:.0f}% match\")\n","\n","    print(f\"\\n  ── DESCRIPTION ────────────────────────────────────\")\n","    print(f\"  {info['description']}\")\n","\n","    print(f\"\\n  ── VISIBLE SIGNS ──────────────────────────────────\")\n","    for i, sign in enumerate(info['visible_signs'], 1):\n","        print(f\"  {i}. {sign}\")\n","\n","    print(f\"\\n  ── HOW IT SPREADS ─────────────────────────────────\")\n","    print(f\"  {info['spread']}\")\n","\n","    print(f\"\\n  ── TREATMENT STEPS ────────────────────────────────\")\n","    for i, t in enumerate(info['treatment'], 1):\n","        print(f\"  {i}. {t}\")\n","\n","    print(f\"\\n  ── PREVENTION ─────────────────────────────────────\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":297},"executionInfo":{"elapsed":55,"status":"error","timestamp":1785383568012,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"b4c1z2kmqxoh","outputId":"3a1821c1-dcca-4803-c73e-5eafe1029dd8"},"outputs":[{"output_type":"stream","name":"stdout","text":["\n","🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿\n","TESTING MODULE 1: LEAF DISEASE DETECTION\n","🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿🌿\n","\n"]},{"output_type":"error","ename":"FileNotFoundError","evalue":"[Errno 2] No such file or directory: 'mulberry_data/Mulberry Data/Leaf Rust'","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mFileNotFoundError\u001b[0m                         Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_2976/4289557857.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     11\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     12\u001b[0m \u001b[0mfolder\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mos\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mpath\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mjoin\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mDATA_PATH\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m'Leaf Rust'\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 13\u001b[0;31m \u001b[0mimg\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mrandom\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mchoice\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mos\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mlistdir\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mfolder\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m     14\u001b[0m \u001b[0mpredict_disease\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mos\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mpath\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mjoin\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mfolder\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mimg\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     15\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mFileNotFoundError\u001b[0m: [Errno 2] No such file or directory: 'mulberry_data/Mulberry Data/Leaf Rust'"]}],"source":["# CELL 16 — Test all 3 modules independently\n","\n","import os, random\n","\n","DATA_PATH = 'mulberry_data/Mulberry Data'\n","\n","# ── TEST MODULE 1: Leaf Disease Detection ─────────────────\n","print(\"\\n\" + \"🌿\"*30)\n","print(\"TESTING MODULE 1: LEAF DISEASE DETECTION\")\n","print(\"🌿\"*30 + \"\\n\")\n","\n","folder = os.path.join(DATA_PATH, 'Leaf Rust')\n","img = random.choice(os.listdir(folder))\n","predict_disease(os.path.join(folder, img))\n","\n","# ── TEST MODULE 2: Silkworm Climate Advisory ──────────────\n","print(\"\\n\" + \"🌡️ \"*20)\n","print(\"TESTING MODULE 2: SILKWORM CLIMATE ADVISORY\")\n","print(\"🌡️ \"*20 + \"\\n\")\n","\n","silkworm_climate_check(\n","    stage    = 'Instar 4',\n","    temp     = 29,       # too high\n","    humidity = 85        # too high\n",")\n","\n","# ── TEST MODULE 3: Silkworm Disease Checker ───────────────\n","print(\"\\n\" + \"🐛\"*30)\n","print(\"TESTING MODULE 3: SILKWORM DISEASE DIAGNOSIS\")\n","print(\"🐛\"*30 + \"\\n\")\n","\n","# Farmer observes these symptoms in their silkworms\n","observed_symptoms = [\n","    'body_swollen',\n","    'skin_shiny',\n","    'sluggish_movement',\n","    'liquid_oozing'\n","]\n","print(f\"Observed symptoms: {observed_symptoms}\\n\")\n","diagnose_silkworm_disease(observed_symptoms)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":7343,"status":"ok","timestamp":1785383582946,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"WJXFlUDhQQUZ","outputId":"01c2aa81-9a74-4b92-b277-94c8833fe5ee"},"outputs":[{"output_type":"stream","name":"stdout","text":["✅ Flask and ngrok installed!\n"]}],"source":["# CELL 17 — Install Flask + ngrok for public URL\n","!pip install flask flask-cors pyngrok -q\n","\n","from pyngrok import ngrok\n","import os\n","\n","# Set your ngrok auth token (free account)\n","# Go to https://dashboard.ngrok.com/signup → get your token → paste below\n","ngrok.set_auth_token(\"3GqzgmX8V6mPWSLFfP9EXbG9jQ6_2KChXfzzCPqTA4He237zR\")\n","\n","print(\"✅ Flask and ngrok installed!\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":1963,"status":"ok","timestamp":1785383587219,"user":{"displayName":"23TUCS212 NITHISHKUMAR D","userId":"09999394654399879086"},"user_tz":-330},"id":"FWdbUmIpPOhg","outputId":"d2b1fb2e-a861-4fb0-933e-eea07a12c5f0"},"outputs":[{"output_type":"stream","name":"stderr","text":["WARNING:absl:Compiled the loaded model, but the compiled metrics have yet to be built. `model.compile_metrics` will be empty until you train or evaluate the model.\n"]},{"output_type":"stream","name":"stdout","text":["✅ Model loaded successfully!\n","✅ Classes: ['Disease Free leaves', 'Leaf Rust', 'Leaf spot']\n","✅ Grad-CAM layer: Conv_1\n"," * Serving Flask app '__main__'\n"," * Debug mode: off\n"]},{"output_type":"stream","name":"stderr","text":["INFO:werkzeug:\u001b[31m\u001b[1mWARNING: This is a development server. Do not use it in a production deployment. Use a production WSGI server instead.\u001b[0m\n"," * Running on http://127.0.0.1:5000\n","INFO:werkzeug:\u001b[33mPress CTRL+C to quit\u001b[0m\n"]},{"output_type":"stream","name":"stdout","text":["==================================================\n","✅ Flask API is LIVE!\n","🌐 Public URL: NgrokTunnel: \"https://encrypt-smite-cobbler.ngrok-free.dev\" -> \"http://localhost:5000\"\n","📋 Test URL: NgrokTunnel: \"https://encrypt-smite-cobbler.ngrok-free.dev\" -> \"http://localhost:5000\"/api/health\n","==================================================\n","Copy the Public URL above — you'll need it for the React frontend!\n"]}],"source":["# ╔══════════════════════════════════════════════════════════════╗\n","# ║  CELL 18 — SeriSense AI: Complete Flask Backend API           ║\n","# ║  Modules: Leaf Disease (+ Grad-CAM) | Climate | Silkworm       ║\n","# ╚══════════════════════════════════════════════════════════════╝\n","\n","# 1. Kill any existing process on port 5000\n","!fuser -k 5000/tcp 2>/dev/null\n","\n","# ── IMPORTS ───────────────────────────────────────────────\n","from flask import Flask, request, jsonify\n","from flask_cors import CORS\n","import numpy as np\n","import cv2\n","import base64\n","from PIL import Image\n","import io, json, threading\n","import tensorflow as tf\n","from tensorflow.keras.models import load_model\n","from pyngrok import ngrok\n","\n","# ── LOAD MODEL & CLASS NAMES ─────────────────────────────\n","model = load_model('/content/drive/MyDrive/mulberry_disease_model_finetuned.h5')\n","print(\"✅ Model loaded successfully!\")\n","\n","with open('/content/drive/MyDrive/class_names.json', 'r') as f:\n","    CLASS_NAMES = json.load(f)\n","print(f\"✅ Classes: {CLASS_NAMES}\")\n","\n","CONFIDENCE_THRESHOLD = 60.0\n","\n","# ── GRAD-CAM SETUP ────────────────────────────────────────\n","def get_last_conv_layer_name(m):\n","    for layer in reversed(m.layers):\n","        if isinstance(layer, tf.keras.layers.Conv2D):\n","            return layer.name\n","        if hasattr(layer, 'layers'):\n","            for sub in reversed(layer.layers):\n","                if isinstance(sub, tf.keras.layers.Conv2D):\n","                    return sub.name\n","    raise ValueError(\"No Conv2D layer found in model\")\n","\n","LAST_CONV_LAYER = get_last_conv_layer_name(model)\n","print(f\"✅ Grad-CAM layer: {LAST_CONV_LAYER}\")\n","\n","def make_gradcam_heatmap(img_array, model, last_conv_layer_name, pred_index=None):\n","    grad_model = tf.keras.models.Model(\n","        [model.inputs],\n","        [model.get_layer(last_conv_layer_name).output, model.output]\n","    )\n","    with tf.GradientTape() as tape:\n","        conv_outputs, predictions = grad_model(img_array)\n","        if pred_index is None:\n","            pred_index = tf.argmax(predictions[0])\n","        class_channel = predictions[:, pred_index]\n","\n","    grads = tape.gradient(class_channel, conv_outputs)\n","    pooled_grads = tf.reduce_mean(grads, axis=(0, 1, 2))\n","    conv_outputs = conv_outputs[0]\n","    heatmap = conv_outputs @ pooled_grads[..., tf.newaxis]\n","    heatmap = tf.squeeze(heatmap)\n","    heatmap = tf.maximum(heatmap, 0) / (tf.math.reduce_max(heatmap) + 1e-8)\n","    return heatmap.numpy()\n","\n","def overlay_gradcam(img_array_uint8, heatmap, alpha=0.4):\n","    img = cv2.resize(img_array_uint8.astype('uint8'), (224, 224))\n","    heatmap_resized = cv2.resize(heatmap, (224, 224))\n","    heatmap_uint8 = np.uint8(255 * heatmap_resized)\n","    heatmap_color = cv2.applyColorMap(heatmap_uint8, cv2.COLORMAP_JET)\n","    heatmap_color = cv2.cvtColor(heatmap_color, cv2.COLOR_BGR2RGB)\n","    overlayed = cv2.addWeighted(img, 1 - alpha, heatmap_color, alpha, 0)\n","    return overlayed\n","\n","def encode_image_to_base64(img_array_rgb):\n","    img_bgr = cv2.cvtColor(img_array_rgb.astype('uint8'), cv2.COLOR_RGB2BGR)\n","    success, buffer = cv2.imencode('.png', img_bgr)\n","    return base64.b64encode(buffer).decode('utf-8')\n","\n","# ── MODULE 1 KNOWLEDGE BASE: LEAF DISEASES ───────────────\n","DISEASE_KNOWLEDGE = {\n","    'Disease Free leaves': {\n","        'severity': 'None',\n","        'status': 'Healthy',\n","        'cause': 'No pathogen detected. The leaf is in optimal health condition.',\n","        'symptoms': [\n","            'Uniform green coloration across leaf surface',\n","            'No visible spots, lesions, or discoloration',\n","            'Intact leaf margins with no curling or wilting',\n","            'Healthy vein structure with no abnormal patterns'\n","        ],\n","        'silkworm_impact': 'Safe to feed. Healthy leaves provide maximum nutritional value for silkworm growth, supporting optimal silk protein synthesis and cocoon quality.',\n","        'chemical': 'None required',\n","        'dosage': 'N/A',\n","        'frequency': 'N/A',\n","        'immediate_actions': [\n","            'Continue regular leaf harvesting schedule',\n","            'Maintain current irrigation and fertilization practices',\n","            'Store harvested leaves in cool, shaded area to preserve freshness',\n","            'Monitor neighboring plants for early signs of disease spread'\n","        ],\n","        'prevention': [\n","            'Maintain proper spacing between mulberry plants (3m x 3m)',\n","            'Apply balanced NPK fertilizer (70:55:70 kg/ha/year)',\n","            'Prune plants regularly to ensure good air circulation',\n","            'Inspect leaves weekly for early disease detection',\n","            'Avoid overhead irrigation to reduce leaf wetness duration'\n","        ]\n","    },\n","    'Leaf Rust': {\n","        'severity': 'High',\n","        'status': 'Infected — Leaf Rust (Cerotelium fici)',\n","        'cause': 'Fungal infection caused by Cerotelium fici (formerly Aecidium mori). Spreads through wind-borne spores (urediniospores) and thrives in warm, humid conditions (25–30°C, >80% RH). The pathogen has an incubation period of 7–10 days.',\n","        'symptoms': [\n","            'Small, round, orange-brown to reddish-brown pustules (uredinia) on the lower leaf surface',\n","            'Corresponding yellow-green spots visible on the upper leaf surface',\n","            'Powdery orange spore masses released when pustules rupture',\n","            'Premature leaf yellowing (chlorosis) and early leaf drop in severe infections',\n","            'Reduced leaf size and curling of leaf margins'\n","        ],\n","        'silkworm_impact': 'DO NOT FEED rust-infected leaves to silkworms. The fungal spores reduce leaf nutritional quality by 40–60%, cause digestive disorders (loose faeces), reduce larval weight gain, and lead to poor quality thin-shelled cocoons with up to 30% reduction in silk yield.',\n","        'chemical': 'Hexaconazole 5% EC (Contaf)',\n","        'dosage': '2 mL per litre of water',\n","        'frequency': 'Spray twice at 15-day intervals. First spray at initial symptom appearance.',\n","        'immediate_actions': [\n","            'Immediately remove and destroy all heavily infected leaves by burning',\n","            'Isolate infected plants — do not harvest leaves from them for silkworm feeding',\n","            'Spray Hexaconazole 5% EC (2 mL/L) covering both upper and lower leaf surfaces',\n","            'Reduce overhead irrigation to minimize leaf surface moisture',\n","            'Apply potassium-rich fertilizer to boost plant immune response'\n","        ],\n","        'prevention': [\n","            'Plant rust-resistant mulberry varieties (S-36, V-1)',\n","            'Maintain proper plant spacing for adequate air circulation',\n","            'Apply preventive fungicide spray (Mancozeb 2.5 g/L) during monsoon season',\n","            'Remove fallen infected leaves from the ground to break the disease cycle',\n","            'Avoid excess nitrogen fertilization which promotes succulent growth susceptible to rust',\n","            'Conduct regular field inspections, especially during humid weather (July–October)'\n","        ]\n","    },\n","    'Leaf spot': {\n","        'severity': 'Moderate',\n","        'status': 'Infected — Leaf Spot (Cercospora moricola)',\n","        'cause': 'Fungal infection caused by Cercospora moricola or Mycosphaerella mori. The pathogen proliferates in warm, humid environments (20–28°C, >85% RH) and spreads through rain splash and contaminated pruning tools. Severity increases during monsoon season.',\n","        'symptoms': [\n","            'Small, circular to irregular brown spots (2–10 mm) with dark brown borders',\n","            'Spots may have a grayish-white center with concentric ring patterns',\n","            'Multiple spots may coalesce to form large necrotic (dead) areas',\n","            'Infected leaves turn yellow around the spots (chlorotic halo)',\n","            'Severe infection causes leaf blight, defoliation, and twig dieback'\n","        ],\n","        'silkworm_impact': 'Mildly infected leaves (less than 10% spots) can be fed after removing spotted portions. Heavily spotted leaves should NOT be fed — they contain fungal toxins that cause silkworm gut inflammation, reduced feeding rate, uneven molting, and increased susceptibility to Flacherie disease.',\n","        'chemical': 'Carbendazim 50% WP (Bavistin)',\n","        'dosage': '1 gram per litre of water',\n","        'frequency': 'Spray 2–3 times at 10-day intervals starting at first symptom appearance.',\n","        'immediate_actions': [\n","            'Remove and destroy severely spotted leaves (>25% leaf area affected)',\n","            'Spray Carbendazim 50% WP (1 g/L) thoroughly on all plant parts',\n","            'Improve air circulation by thinning overcrowded branches',\n","            'Avoid wetting leaves during irrigation — use drip or basin irrigation',\n","            'Disinfect pruning tools with 2% sodium hypochlorite solution between plants'\n","        ],\n","        'prevention': [\n","            'Use disease-free planting material from certified nurseries',\n","            'Apply Bordeaux mixture (1%) as a preventive spray before monsoon onset',\n","            'Maintain field sanitation — remove and compost fallen leaves regularly',\n","            'Avoid water stagnation around plant root zone',\n","            'Apply balanced fertilization — avoid excess nitrogen',\n","            'Intercrop with marigold or neem to reduce fungal spore load in the field'\n","        ]\n","    }\n","}\n","\n","# ── MODULE 2 KNOWLEDGE BASE: SILKWORM CLIMATE RULES ──────\n","SILKWORM_CLIMATE = {\n","    'Egg / Incubation': {\n","        'growth_stage': 'Egg incubation period (10-12 days)',\n","        'temp_min': 25, 'temp_max': 26,\n","        'humidity_min': 80, 'humidity_max': 85,\n","        'too_cold': 'Delayed hatching, uneven emergence over multiple days, reduced hatchability percentage, and weak first-instar larvae.',\n","        'too_hot': 'Premature hatching before leaf readiness, desiccation of eggs, high mortality within 24 hours of hatching.',\n","        'too_dry': 'Egg shell desiccation, membrane hardening preventing larvae from breaking out, leading to complete batch failure.',\n","        'too_humid': 'Fungal growth (Aspergillus) on egg surfaces, bacterial contamination, and suffocation of developing embryos.'\n","    },\n","    'Instar 1': {\n","        'growth_stage': 'First instar (Chawki) — Days 1-4 after hatching',\n","        'temp_min': 26, 'temp_max': 28,\n","        'humidity_min': 85, 'humidity_max': 90,\n","        'too_cold': 'Larvae become sluggish, feeding stops, growth stunted. Mortality can reach 40-60% if temp drops below 22°C.',\n","        'too_hot': 'Rapid dehydration of tiny larvae, leaf wilting too fast for consumption, heat stress causes body fluid loss.',\n","        'too_dry': 'Tender chopped leaves dry out within minutes, larvae cannot bite into hardened leaf surface, starvation risk.',\n","        'too_humid': 'Bacterial bed diseases (Flacherie) outbreak risk increases dramatically. Wet rearing beds cause contact infection.'\n","    },\n","    'Instar 2': {\n","        'growth_stage': 'Second instar (Chawki) — Days 5-7',\n","        'temp_min': 26, 'temp_max': 28,\n","        'humidity_min': 80, 'humidity_max': 85,\n","        'too_cold': 'Delayed molting, uneven growth among batch, prolonged vulnerability to viral infections during extended molt.',\n","        'too_hot': 'Excessive moisture loss through spiracles, restless movement instead of feeding, weight gain drops 30%.',\n","        'too_dry': 'Leaves become crispy and unpalatable, larvae cluster at leaf veins seeking moisture, uneven growth.',\n","        'too_humid': 'Muscardine fungal spores germinate on larval skin, white/green fungal patches appear within 48 hours.'\n","    },\n","    'Instar 3': {\n","        'growth_stage': 'Third instar (Late-age begins) — Days 8-11',\n","        'temp_min': 25, 'temp_max': 26,\n","        'humidity_min': 75, 'humidity_max': 80,\n","        'too_cold': 'Silk gland development slows, larvae enter semi-dormant state, batch rearing period extends by 2-3 days.',\n","        'too_hot': 'Larvae pant and lift heads (heat stress behavior), reduced silk protein synthesis, body becomes translucent.',\n","        'too_dry': 'Increased water consumption from leaves reduces actual nutrition absorption, silk glands remain underdeveloped.',\n","        'too_humid': 'Grasserie (NPV) virus activation — larvae swell, skin becomes shiny, body fluid turns milky white (fatal).'\n","    },\n","    'Instar 4': {\n","        'growth_stage': 'Fourth instar — Days 12-16',\n","        'temp_min': 24, 'temp_max': 26,\n","        'humidity_min': 70, 'humidity_max': 75,\n","        'too_cold': 'Major silk gland development disrupted, final cocoon shell will be thin and commercially unviable.',\n","        'too_hot': 'Larvae become hyperactive, waste energy moving instead of silk synthesis, cocoon weight drops 20-40%.',\n","        'too_dry': 'Larvae consume 30% more leaves but convert poorly to silk protein, economic feed-conversion ratio worsens.',\n","        'too_humid': 'Bed dampness triggers Flacherie complex — larvae vomit gut juice, body softens, chain mortality in rearing tray.'\n","    },\n","    'Instar 5': {\n","        'growth_stage': 'Fifth instar (Final feeding stage) — Days 17-23',\n","        'temp_min': 23, 'temp_max': 25,\n","        'humidity_min': 65, 'humidity_max': 70,\n","        'too_cold': 'Cocoon spinning delayed, irregular cocoon shape, double cocoons (two larvae in one), reduced reelability.',\n","        'too_hot': 'Premature spinning with insufficient silk reserve, thin-shelled cocoons, pupae die inside from heat.',\n","        'too_dry': 'Larvae spin loose, fluffy cocoons with poor silk quality (non-reelable waste silk percentage increases to 40%).',\n","        'too_humid': 'Cocoons absorb moisture and develop mold, stained silk threads, entire harvest can be rejected at market.'\n","    }\n","}\n","\n","# ── MODULE 3 KNOWLEDGE BASE: SILKWORM DISEASES ───────────\n","SILKWORM_DISEASES = {\n","    'Grasserie (Nuclear Polyhedrosis)': {\n","        'also_known_as': 'Nuclear Polyhedrosis Virus (NPV) / Jaundice disease / Hanging disease',\n","        'type': 'Viral',\n","        'severity': 'Very High',\n","        'mortality': '80-100% in affected batch if untreated',\n","        'description': 'Grasserie is the most devastating viral disease of silkworms caused by Bombyx mori Nuclear Polyhedrosis Virus (BmNPV). The virus attacks the fat body, blood cells, and silk glands. Infected larvae swell, become shiny, and eventually rupture, releasing millions of viral particles that contaminate the entire rearing environment.',\n","        'symptoms': [\n","            'Swollen, shiny, and translucent body (skin appears stretched)',\n","            'Larvae climb to top of rearing tray and hang head-down (hence \"hanging disease\")',\n","            'Milky white body fluid (haemolymph) instead of clear',\n","            'Intersegmental swelling — body segments bulge outward',\n","            'Larvae stop feeding and become restless',\n","            'Skin ruptures easily, releasing turbid milky fluid',\n","            'Body turns yellowish-brown before death',\n","            'Dead larvae hang limply, body liquefies within hours'\n","        ],\n","        'visible_signs': [\n","            'Shiny, taut integument (skin) that looks oily',\n","            'Swollen intersegmental membranes',\n","            'Larvae hanging from mountage or tray edges',\n","            'Milky white fluid oozing from ruptured larvae',\n","            'Foul smell from decomposing dead larvae'\n","        ],\n","        'spread': 'Oral infection through contaminated mulberry leaves, contact with ruptured infected larvae, contaminated rearing equipment, and by adult moths during egg-laying (transovarian transmission).',\n","        'treatment': [\n","            'No cure exists — remove and burn all infected larvae immediately',\n","            'Disinfect entire rearing house with 2% formalin solution',\n","            'Apply slaked lime (calcium hydroxide) powder on rearing beds at 2 kg per 100 sq ft',\n","            'Spray Vijetha (BmNPV disinfectant) at recommended dosage on rearing equipment',\n","            'Stop rearing in the affected room for at least 15 days after complete disinfection',\n","            'Wash all rearing trays with 5% bleaching powder solution and sun-dry for 3 days'\n","        ],\n","        'prevention': [\n","            'Use only disease-free layings (DFLs) from authorized grainage centers',\n","            'Disinfect rearing house with 2% formalin + 0.5% slaked lime before each rearing season',\n","            'Wash mulberry leaves with clean water before feeding',\n","            'Maintain proper temperature (24-26°C) and humidity (65-75%) during late-age rearing',\n","            'Avoid overcrowding — maintain 600 larvae per sq ft for late instars',\n","            'Remove dead/diseased larvae promptly, at least twice daily',\n","            'Use bed disinfectants (Vijetha/RKO) after every molt'\n","        ]\n","    },\n","    'Flacherie (Bacterial/Viral)': {\n","        'also_known_as': 'Bacterial Flacherie / Sotto disease / Thatte roga',\n","        'type': 'Bacterial + Viral complex',\n","        'severity': 'High',\n","        'mortality': '30-90% depending on pathogen combination',\n","        'description': 'Flacherie is a complex disease involving both bacterial (Bacillus thuringiensis, Streptococcus, Staphylococcus) and viral (BmIFV - Infectious Flacherie Virus) pathogens. It primarily attacks the midgut, disrupting digestion and nutrient absorption. The disease is strongly associated with poor rearing conditions, especially high temperature and humidity.',\n","        'symptoms': [\n","            'Larvae become soft and flaccid (hence name \"Flacherie\")',\n","            'Vomiting of gut juice (brownish liquid from mouth)',\n","            'Body shrinks and becomes wrinkled',\n","            'Larvae stop eating but remain on leaf surface',\n","            'Irregular, loose, watery frass (droppings)',\n","            'Body color turns dark brown to black',\n","            'Larvae emit foul odor',\n","            'Chain mortality — dead larvae appear in sequence along rearing bed'\n","        ],\n","        'visible_signs': [\n","            'Soft, flaccid body that does not regain shape when pressed',\n","            'Brownish vomit stains around mouth parts',\n","            'Dark, watery frass (not normal pellet-shaped)',\n","            'Foul rotting smell in rearing room',\n","            'Dead larvae turn black and liquefy rapidly'\n","        ],\n","        'spread': 'Through contaminated mulberry leaves (with bacteria), oral-fecal route via infected frass, contaminated rearing trays, and stress-induced gut bacterial overgrowth. Poor sanitation and high temperature/humidity are major predisposing factors.',\n","        'treatment': [\n","            'Remove and destroy all affected larvae by burning or deep burial',\n","            'Apply lime powder (Calcium hydroxide) liberally on rearing beds to reduce bacterial load',\n","            'Spray Labex (0.3%) solution on remaining healthy larvae as a bed disinfectant',\n","            'Reduce rearing room temperature to 24-25°C immediately using wet gunny bags or coolers',\n","            'Reduce humidity to 65-70% by improving ventilation (open windows, use exhaust fans)',\n","            'Provide only fresh, dry mulberry leaves — avoid wilted or bruised leaves',\n","            'Increase bed cleaning frequency to 3 times per day'\n","        ],\n","        'prevention': [\n","            'Maintain strict hygiene in rearing house — daily disinfection of floor with 2% bleaching powder',\n","            'Control temperature at 24-26°C and humidity at 65-75% during late instars',\n","            'Avoid feeding wet, wilted, or overheated leaves',\n","            'Do not overcrowd rearing beds — maintain proper spacing',\n","            'Apply bed disinfectant (Vijetha/Ankush) after every molt',\n","            'Use antibiotics (Chloramphenicol 0.1%) in drinking water only under expert guidance',\n","            'Ensure proper drainage around rearing shed to prevent waterlogging'\n","        ]\n","    },\n","    'Muscardine (Fungal)': {\n","        'also_known_as': 'White Muscardine / Green Muscardine / Beauveria bassiana infection',\n","        'type': 'Fungal',\n","        'severity': 'Moderate to High',\n","        'mortality': '20-60% in favorable fungal growth conditions',\n","        'description': 'Muscardine is a fungal disease caused by Beauveria bassiana (White Muscardine) or Metarhizium anisopliae (Green Muscardine). The fungal spores land on the larval skin, germinate, and penetrate through the cuticle. The fungus grows internally, consuming body nutrients, and eventually the larvae die and become mummified with a hard, chalk-like body covered in fungal spores.',\n","        'symptoms': [\n","            'Larvae become inactive and stop feeding',\n","            'Small dark spots appear on the body surface (initial fungal penetration points)',\n","            'Body gradually becomes stiff and hard (rigor)',\n","            'White or green powdery fungal growth covers the dead larva (mummification)',\n","            'Larvae die in a stretched, rigid position',\n","            'Hard, chalky, mummified cadaver within 2-3 days of death',\n","            'Powdery spores spread from dead larvae when disturbed'\n","        ],\n","        'visible_signs': [\n","            'Hard, mummified dead larvae covered in white/green powder',\n","            'Chalky, stiff cadavers that do not decompose',\n","            'Fine powder (spores) falling from dead larvae when touched',\n","            'Dark melanized spots on live larvae (early infection sign)'\n","        ],\n","        'spread': 'Through airborne fungal spores (conidia), direct contact with infected cadavers, contaminated rearing trays and mountages, and from soil around the rearing house. High humidity (>80%) and moderate temperature (20-28°C) strongly favor spore germination.',\n","        'treatment': [\n","            'Remove and burn all mummified cadavers and heavily infected larvae immediately',\n","            'Reduce rearing room humidity below 70% by improving ventilation',\n","            'Dust rearing beds with slaked lime powder mixed with RKO (bed disinfectant)',\n","            'Spray 0.3% Dithane M-45 (Mancozeb) on rearing equipment and room walls',\n","            'Provide well-ventilated, dry rearing environment',\n","            'Sun-dry all rearing trays and mountages for 2-3 consecutive days',\n","            'Apply Vijetha powder on rearing beds at 5 g per sq ft'\n","        ],\n","        'prevention': [\n","            'Maintain rearing room humidity at 65-75% — avoid damp conditions',\n","            'Ensure good ventilation and air circulation in rearing house',\n","            'Disinfect rearing room with 2% formalin spray before each crop',\n","            'Sun-dry rearing equipment for at least 48 hours before use',\n","            'Use bed disinfectant powder after every molt (Vijetha or RKO)',\n","            'Avoid rearing near paddy fields or compost heaps (source of fungal spores)',\n","            'Paint rearing house walls with lime wash containing copper sulfate (0.1%)'\n","        ]\n","    },\n","    'Pebrine (Microsporidian)': {\n","        'also_known_as': 'Nosema disease / Pepper disease / Pébrine',\n","        'type': 'Microsporidian (Protozoan)',\n","        'severity': 'Very High (Chronic)',\n","        'mortality': '50-100% across generations (transovarial spread)',\n","        'description': 'Pebrine is a chronic, debilitating disease caused by the microsporidian parasite Nosema bombycis. It is the most historically significant silkworm disease, having nearly destroyed the European silk industry in the 1860s until Louis Pasteur identified its cause. The parasite infects every tissue of the silkworm, including silk glands and reproductive organs, and passes from mother moth to eggs (transovarial transmission).',\n","        'symptoms': [\n","            'Uneven larval growth within the same batch (irregular sizes)',\n","            'Small, dark brown to black pepper-like spots on the body (hence \"pepper disease\")',\n","            'Larvae become undersized and fail to grow at normal rate',\n","            'Reduced appetite and sluggish feeding behavior',\n","            'Irregular molting — some larvae fail to complete moult',\n","            'Larvae that survive spin very thin, loose, defective cocoons',\n","            'Adult moths from infected larvae have deformed wings and lay fewer eggs',\n","            'Eggs laid by infected moths fail to hatch or produce weak larvae'\n","        ],\n","        'visible_signs': [\n","            'Pepper-like dark spots scattered across larval body',\n","            'Uneven-sized larvae in the same tray (some much smaller)',\n","            'Thin, flimsy cocoons easily crushed by hand',\n","            'Deformed, weak adult moths with crumpled wings',\n","            'Microscopic examination shows oval refractile spores (Nosema bombycis)'\n","        ],\n","        'spread': 'Primarily transovarial (infected mother moth → eggs). Also through oral ingestion of spore-contaminated mulberry leaves, contact with infected larval frass, and contaminated rearing equipment. Spores are extremely resistant and survive in the environment for years.',\n","        'treatment': [\n","            'No cure available — destroy the entire infected batch by burning',\n","            'All eggs from the infected batch must be destroyed (transovarial spread)',\n","            'Thoroughly disinfect rearing house with 2% formalin for 24 hours in sealed room',\n","            'Destroy all rearing materials that contacted infected batch',\n","            'Report to nearest sericulture department for fresh disease-free layings (DFLs)',\n","            'Fumigate rearing room with formaldehyde gas (follow safety protocols)'\n","        ],\n","        'prevention': [\n","            'MOST CRITICAL: Use only certified disease-free layings (DFLs) from government grainage',\n","            'Mother moth examination (Pebrine testing) is mandatory — reject any infected egg batches',\n","            'Disinfect rearing house and all equipment with 2% formalin before every rearing season',\n","            'Wash mulberry leaves thoroughly before feeding',\n","            'Maintain field hygiene — remove dead and diseased insects from mulberry garden',\n","            'Do not use eggs from unknown or unexamined sources',\n","            'Conduct microscopic examination of crushed moth bodies to detect Nosema spores'\n","        ]\n","    }\n","}\n","\n","# ── MODULE 3: SYMPTOM → DISEASE MAPPING ──────────────────\n","SYMPTOM_DISEASE_MAP = {\n","    'Swollen, shiny, translucent body': ['Grasserie (Nuclear Polyhedrosis)'],\n","    'Larvae hanging head-down from tray': ['Grasserie (Nuclear Polyhedrosis)'],\n","    'Milky white body fluid': ['Grasserie (Nuclear Polyhedrosis)'],\n","    'Skin ruptures easily, oozing fluid': ['Grasserie (Nuclear Polyhedrosis)'],\n","    'Intersegmental swelling': ['Grasserie (Nuclear Polyhedrosis)'],\n","    'Yellowish-brown body before death': ['Grasserie (Nuclear Polyhedrosis)'],\n","    'Body liquefies after death': ['Grasserie (Nuclear Polyhedrosis)', 'Flacherie (Bacterial/Viral)'],\n","    'Larvae stop feeding': ['Grasserie (Nuclear Polyhedrosis)', 'Flacherie (Bacterial/Viral)', 'Muscardine (Fungal)', 'Pebrine (Microsporidian)'],\n","    'Soft, flaccid body': ['Flacherie (Bacterial/Viral)'],\n","    'Vomiting brownish gut juice': ['Flacherie (Bacterial/Viral)'],\n","    'Body shrinks and wrinkles': ['Flacherie (Bacterial/Viral)'],\n","    'Watery, loose droppings (frass)': ['Flacherie (Bacterial/Viral)'],\n","    'Dark brown to black body color': ['Flacherie (Bacterial/Viral)'],\n","    'Foul rotting smell': ['Flacherie (Bacterial/Viral)', 'Grasserie (Nuclear Polyhedrosis)'],\n","    'Chain mortality in rearing bed': ['Flacherie (Bacterial/Viral)'],\n","    'Body becomes stiff and hard': ['Muscardine (Fungal)'],\n","    'White powdery coating on dead larva': ['Muscardine (Fungal)'],\n","    'Green powdery coating on dead larva': ['Muscardine (Fungal)'],\n","    'Mummified chalky cadaver': ['Muscardine (Fungal)'],\n","    'Dark spots on body surface': ['Muscardine (Fungal)', 'Pebrine (Microsporidian)'],\n","    'Larvae die in stretched rigid position': ['Muscardine (Fungal)'],\n","    'Uneven growth within same batch': ['Pebrine (Microsporidian)'],\n","    'Pepper-like dark spots on body': ['Pebrine (Microsporidian)'],\n","    'Undersized larvae, stunted growth': ['Pebrine (Microsporidian)'],\n","    'Irregular or failed molting': ['Pebrine (Microsporidian)'],\n","    'Thin, defective, loose cocoons': ['Pebrine (Microsporidian)'],\n","    'Deformed adult moths with crumpled wings': ['Pebrine (Microsporidian)'],\n","    'Reduced appetite, sluggish feeding': ['Pebrine (Microsporidian)', 'Flacherie (Bacterial/Viral)', 'Muscardine (Fungal)'],\n","    'Restless movement, not settling on leaves': ['Grasserie (Nuclear Polyhedrosis)', 'Flacherie (Bacterial/Viral)']\n","}\n","\n","# ── FLASK APP SETUP ───────────────────────────────────────\n","app = Flask(__name__)\n","CORS(app)\n","\n","# ── ENDPOINT: MODULE 1 — LEAF DISEASE DETECTION (with Grad-CAM) ──\n","@app.route('/api/predict-disease', methods=['POST'])\n","def predict_disease_api():\n","    try:\n","        file = request.files.get('image') or request.files.get('file')\n","        if not file:\n","            return jsonify({'success': False, 'error': 'No image uploaded'}), 400\n","\n","        img = Image.open(file.stream).convert('RGB').resize((224, 224))\n","        img_array_raw = np.array(img)  # 0-255, for Grad-CAM overlay\n","        img_array_norm = np.expand_dims(img_array_raw / 255.0, axis=0)  # 0-1, for model\n","\n","        preds = model.predict(img_array_norm, verbose=0)\n","        confidence_scores = {\n","            CLASS_NAMES[i]: float(preds[0][i]) * 100\n","            for i in range(len(CLASS_NAMES))\n","        }\n","        predicted_class = max(confidence_scores, key=confidence_scores.get)\n","        confidence = confidence_scores[predicted_class]\n","        is_uncertain = confidence < CONFIDENCE_THRESHOLD\n","\n","        # ── Grad-CAM ──\n","        pred_index = CLASS_NAMES.index(predicted_class)\n","        heatmap = make_gradcam_heatmap(img_array_norm, model, LAST_CONV_LAYER, pred_index)\n","        overlayed = overlay_gradcam(img_array_raw, heatmap)\n","        gradcam_base64 = encode_image_to_base64(overlayed)\n","\n","        # ── Uncertainty override ──\n","        if is_uncertain:\n","            info = {\n","                'severity': 'Unknown',\n","                'status': 'Uncertain — please retake photo',\n","                'cause': 'Confidence below safe threshold (60%). Possibly blurry image, poor lighting, or non-leaf object.',\n","                'symptoms': ['Confidence below 60% threshold'],\n","                'silkworm_impact': 'Do not act on this result — retake the photo in good lighting.',\n","                'chemical': 'N/A', 'dosage': 'N/A', 'frequency': 'N/A',\n","                'immediate_actions': ['Retake photo in good natural lighting', 'Fill frame with a single leaf', 'Avoid blur and shadows'],\n","                'prevention': ['Use daylight, not artificial light', 'Hold the camera steady']\n","            }\n","        else:\n","            info = DISEASE_KNOWLEDGE[predicted_class]\n","\n","        return jsonify({\n","            'success': True,\n","            'predicted_class': predicted_class,\n","            'confidence': round(confidence, 1),\n","            'is_uncertain': is_uncertain,\n","            'gradcam_image': f\"data:image/png;base64,{gradcam_base64}\",\n","            'all_scores': {k: round(v, 1) for k, v in confidence_scores.items()},\n","            'severity': info['severity'],\n","            'status': info['status'],\n","            'cause': info['cause'],\n","            'symptoms': info['symptoms'],\n","            'silkworm_impact': info['silkworm_impact'],\n","            'chemical': info['chemical'],\n","            'dosage': info['dosage'],\n","            'frequency': info['frequency'],\n","            'immediate_actions': info['immediate_actions'],\n","            'prevention': info['prevention']\n","        })\n","    except Exception as e:\n","        print(f\"❌ PREDICT ERROR: {e}\")\n","        return jsonify({'success': False, 'error': str(e)}), 500\n","\n","# ── ENDPOINT: MODULE 2 — SILKWORM CLIMATE ADVISORY ───────\n","@app.route('/api/climate-check', methods=['POST'])\n","def climate_check_api():\n","    try:\n","        data = request.get_json()\n","        stage    = data['stage']\n","        temp     = float(data['temperature'])\n","        humidity = float(data['humidity'])\n","\n","        rule = SILKWORM_CLIMATE[stage]\n","        issues       = []\n","        consequences = []\n","        corrections  = []\n","        status = 'SAFE'\n","\n","        if temp < rule['temp_min']:\n","            diff = round(rule['temp_min'] - temp, 1)\n","            issues.append(f\"Temperature {diff}°C BELOW ideal range\")\n","            consequences.append(rule['too_cold'])\n","            corrections.append(\n","                f\"Increase temperature by {diff}°C → Target: {rule['temp_min']}–{rule['temp_max']}°C\"\n","            )\n","            status = 'WARNING' if diff <= 2 else 'CRITICAL'\n","        elif temp > rule['temp_max']:\n","            diff = round(temp - rule['temp_max'], 1)\n","            issues.append(f\"Temperature {diff}°C ABOVE ideal range\")\n","            consequences.append(rule['too_hot'])\n","            corrections.append(\n","                f\"Decrease temperature by {diff}°C → Target: {rule['temp_min']}–{rule['temp_max']}°C\"\n","            )\n","            status = 'WARNING' if diff <= 2 else 'CRITICAL'\n","\n","        if humidity < rule['humidity_min']:\n","            diff = round(rule['humidity_min'] - humidity, 1)\n","            issues.append(f\"Humidity {diff}% BELOW ideal range\")\n","            consequences.append(rule['too_dry'])\n","            corrections.append(\n","                f\"Increase humidity by {diff}% → Use humidifier → Target: {rule['humidity_min']}–{rule['humidity_max']}% RH\"\n","            )\n","            if status != 'CRITICAL':\n","                status = 'WARNING' if diff <= 5 else 'CRITICAL'\n","        elif humidity > rule['humidity_max']:\n","            diff = round(humidity - rule['humidity_max'], 1)\n","            issues.append(f\"Humidity {diff}% ABOVE ideal range\")\n","            consequences.append(rule['too_humid'])\n","            corrections.append(\n","                f\"Decrease humidity by {diff}% → Improve ventilation → Target: {rule['humidity_min']}–{rule['humidity_max']}% RH\"\n","            )\n","            if status != 'CRITICAL':\n","                status = 'WARNING' if diff <= 5 else 'CRITICAL'\n","\n","        return jsonify({\n","            'success'       : True,\n","            'stage'         : stage,\n","            'growth_stage'  : rule['growth_stage'],\n","            'current_temp'  : temp,\n","            'current_humidity': humidity,\n","            'ideal_temp'    : f\"{rule['temp_min']}–{rule['temp_max']}°C\",\n","            'ideal_humidity': f\"{rule['humidity_min']}–{rule['humidity_max']}% RH\",\n","            'status'        : status,\n","            'issues'        : issues,\n","            'consequences'  : consequences,\n","            'corrections'   : corrections\n","        })\n","    except Exception as e:\n","        print(f\"❌ CLIMATE ERROR: {e}\")\n","        return jsonify({'success': False, 'error': str(e)}), 500\n","\n","# ── ENDPOINT: MODULE 3 — SILKWORM DISEASE CHECKER ────────\n","@app.route('/api/diagnose-silkworm', methods=['POST'])\n","def diagnose_silkworm_api():\n","    try:\n","        data = request.get_json()\n","        selected_symptoms = data['symptoms']\n","\n","        disease_scores = {d: 0 for d in SILKWORM_DISEASES}\n","        for symptom in selected_symptoms:\n","            if symptom in SYMPTOM_DISEASE_MAP:\n","                for disease in SYMPTOM_DISEASE_MAP[symptom]:\n","                    disease_scores[disease] += 1\n","\n","        ranked = sorted(disease_scores.items(), key=lambda x: x[1], reverse=True)\n","        top_disease = ranked[0][0]\n","        top_score   = ranked[0][1]\n","\n","        if top_score == 0:\n","            return jsonify({'success': True, 'no_match': True})\n","\n","        info = SILKWORM_DISEASES[top_disease]\n","        match_pct = round((top_score / len(info['symptoms'])) * 100, 1)\n","\n","        other_matches = []\n","        for disease, score in ranked[1:]:\n","            if score > 0:\n","                pct = round((score / len(SILKWORM_DISEASES[disease]['symptoms'])) * 100, 1)\n","                other_matches.append({'disease': disease, 'match_percent': pct})\n","\n","        return jsonify({\n","            'success'       : True,\n","            'no_match'      : False,\n","            'top_disease'   : top_disease,\n","            'also_known_as' : info['also_known_as'],\n","            'type'          : info['type'],\n","            'severity'      : info['severity'],\n","            'match_percent' : match_pct,\n","            'mortality'     : info['mortality'],\n","            'description'   : info['description'],\n","            'visible_signs' : info['visible_signs'],\n","            'spread'        : info['spread'],\n","            'treatment'     : info['treatment'],\n","            'prevention'    : info['prevention'],\n","            'other_matches' : other_matches\n","        })\n","    except Exception as e:\n","        print(f\"❌ DIAGNOSE ERROR: {e}\")\n","        return jsonify({'success': False, 'error': str(e)}), 500\n","\n","# ── ENDPOINT: GET ALL SYMPTOMS LIST (for Module 3 UI) ────\n","@app.route('/api/symptoms-list', methods=['GET'])\n","def get_symptoms():\n","    symptoms = list(SYMPTOM_DISEASE_MAP.keys())\n","    return jsonify({'symptoms': symptoms})\n","\n","# ── ENDPOINT: HEALTH CHECK ───────────────────────────────\n","@app.route('/api/health', methods=['GET'])\n","def health():\n","    return jsonify({\n","        'status': 'running',\n","        'model_loaded': model is not None,\n","        'classes': CLASS_NAMES,\n","        'confidence_threshold': CONFIDENCE_THRESHOLD,\n","        'gradcam_enabled': True,\n","        'modules': ['disease', 'climate', 'silkworm']\n","    })\n","\n","# ── START FLASK + NGROK ───────────────────────────────────\n","def run_flask():\n","    app.run(port=5000, debug=False, use_reloader=False)\n","\n","thread = threading.Thread(target=run_flask)\n","thread.daemon = True\n","thread.start()\n","\n","# Open public tunnel\n","public_url = ngrok.connect(5000)\n","print(\"=\" * 50)\n","print(f\"✅ Flask API is LIVE!\")\n","print(f\"🌐 Public URL: {public_url}\")\n","print(f\"📋 Test URL: {public_url}/api/health\")\n","print(\"=\" * 50)\n","print(\"Copy the Public URL above — you'll need it for the React frontend!\")"]}],"metadata":{"colab":{"provenance":[{"file_id":"1YRzxm51MzKa4RZzv96PjHI6JBnUl-S_J","timestamp":1784713838048}],"authorship_tag":"ABX9TyMz8ywwv/SfRuelH4pM+ULk"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}